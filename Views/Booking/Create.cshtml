@model List<Bus_ticket.Models.Trip>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Chuyến Xe & Đặt Vé";
    var tripCount = Model?.Count ?? 0;
}

<div class="p-6 sm:p-8 flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Hệ Thống Đặt Vé Tại Quầy</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Tìm kiếm hành trình, chọn chuyến chạy thực tế và giữ chỗ cho
                khách.</p>
        </div>
        <div>
            <button onclick="window.location.reload();"
                    class="bg-amber-500 hover:bg-amber-600 text-black font-bold py-2 px-4 rounded-lg flex items-center gap-2">
                <i class="fas fa-sync-alt"></i> Làm mới dữ liệu
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center p-4 text-sm text-emerald-800 dark:text-emerald-400 rounded-lg bg-emerald-50 dark:bg-gray-800 border border-emerald-200 dark:border-emerald-800">
            <div><span class="font-medium">Thành công!</span> @TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center p-4 text-sm text-red-800 dark:text-red-400 rounded-lg bg-red-50 dark:bg-gray-800 border border-red-200 dark:border-red-800">
            <div><span class="font-medium">Thất bại!</span> @TempData["ErrorMessage"]</div>
        </div>
    }

    <!-- THANH TÌM KIẾM HÀNH TRÌNH -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-5 mb-6 shadow-xl">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 items-end">
            <div class="relative">
                <label class="block mb-1.5 text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase">Nơi xuất phát</label>
                <div class="flex items-center bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2">
                    <span class="text-amber-500 dark:text-amber-400 mr-2">🔵</span>
                    <input type="text" id="txtDeparture" placeholder="Ví dụ: Hà Nội" autocomplete="off"
                           class="w-full bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none"/>
                </div>
                <div id="dropDeparture"
                     class="absolute left-0 z-50 hidden w-full mt-1 bg-white text-gray-800 rounded-lg shadow-2xl border border-gray-200 max-h-60 overflow-y-auto text-xs divide-y divide-gray-100"></div>
            </div>

            <div class="relative">
                <label class="block mb-1.5 text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase">Nơi đến</label>
                <div class="flex items-center bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2">
                    <span class="text-rose-500 mr-2">📍</span>
                    <input type="text" id="txtDestination" placeholder="Ví dụ: Nghệ An" autocomplete="off"
                           class="w-full bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none"/>
                </div>
                <div id="dropDestination"
                     class="absolute left-0 z-50 hidden w-full mt-1 bg-white text-gray-800 rounded-lg shadow-2xl border border-gray-200 max-h-60 overflow-y-auto text-xs divide-y divide-gray-100"></div>
            </div>

            <div>
                <label class="block mb-1.5 text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase">Ngày đi</label>
                <div class="flex items-center bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg px-3 py-2">
                    <span class="text-blue-500 dark:text-blue-400 mr-2">📅</span>
                    <input type="date" id="txtTravelDate" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full bg-transparent text-sm text-gray-900 dark:text-white focus:outline-none admin-date-input"/>
                </div>
            </div>

            <div>
                <button type="button" onclick="searchTripsByRoute()"
                        class="w-full bg-amber-400 hover:bg-amber-500 text-gray-900 font-bold text-sm py-2.5 px-4 rounded-lg transition-all shadow-md">
                    Tìm kiếm chuyến chạy
                </button>
            </div>
        </div>
    </div>

    <!-- SẮP XẾP KẾT QUẢ -->
    <div
        class="mb-4 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-3 rounded-xl flex flex-wrap items-center justify-between gap-3">
        <div class="text-xs font-semibold text-gray-700 dark:text-gray-400">📊 Sắp xếp chuyến xe:</div>
        <div class="flex items-center gap-4 flex-wrap text-xs text-gray-700 dark:text-gray-200">
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tripSort" value="default" checked
                       class="text-amber-500 focus:ring-amber-400 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600" onchange="renderFilteredTrips()">
                <span>Mặc định</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tripSort" value="timeAsc"
                       class="text-amber-500 focus:ring-amber-400 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600" onchange="renderFilteredTrips()">
                <span>Giờ đi sớm nhất</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tripSort" value="priceAsc"
                       class="text-amber-500 focus:ring-amber-400 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600" onchange="renderFilteredTrips()">
                <span>Giá tăng dần</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="tripSort" value="priceDesc"
                       class="text-amber-500 focus:ring-amber-400 bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600" onchange="renderFilteredTrips()">
                <span>Giá giảm dần</span>
            </label>
        </div>
    </div>

    <!-- VÙNG CHỨA DANH SÁCH CHUYẾN XE (CARDS) -->
    <div id="searchResultArea" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

    <!-- PHÂN PHẦN THÔNG TIN CHI TIẾT ĐẶT VÉ -->
    <div id="bookingDetailSection" class="hidden w-full">
        <form asp-action="BookTicket" asp-controller="Booking" method="post" id="formBooking"
              class="flex flex-wrap lg:flex-nowrap gap-6 w-full items-start">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tripId" id="hidTripId"/>
            <input type="hidden" name="seatHoldCode" id="seatHoldCode"/>
            <div id="hidden-seats-container"></div>

            <div class="flex-1 min-w-[320px] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-xl">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Thông tin khách hàng</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase mb-1">Số điện thoại</label>
                        <input type="tel" name="passengerPhone" id="txtPassengerPhone" required
                               class="w-full px-4 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase mb-1">Tên hành
                                khách</label>
                            <input type="text" name="passengerName" id="txtPassengerName" required
                                   class="w-full px-4 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase mb-1">Ngày sinh</label>
                            <input type="date" id="inputDob" name="dob" onchange="calculateAge()" required
                                   class="w-full px-4 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 dark:text-gray-400 uppercase mb-1">Email</label>
                        <input type="email" name="passengerEmail" id="txtPassengerEmail"
                               class="w-full px-4 py-2 text-gray-900 dark:text-white bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                    </div>
                    <div class="p-3 bg-amber-400/10 border border-amber-400/30 rounded-lg">
                        <p class="text-sm text-gray-700 dark:text-gray-300">Ghế đã chọn: <span id="txtSeatNum"
                                                                            class="font-bold text-amber-600 dark:text-amber-400">Chưa chọn</span>
                        </p>
                        <p id="seatHoldTimerText" class="hidden mt-1 text-xs font-semibold text-amber-700 dark:text-amber-300">⏳ Thời gian giữ chỗ còn: <span id="seatHoldCountdown">05:00</span></p>
                        <p class="text-[11px] text-gray-600 dark:text-gray-500 mt-1">Ghế chưa bị giữ khi bạn chọn. Sau khi xác nhận đặt vé và chuyển sang thanh toán, ghế sẽ được giữ trong 5 phút.</p>
                        <p class="text-xs text-gray-600 dark:text-gray-500">Tuổi hiện tại: <span id="displayAge">--</span></p>
                    </div>
                </div>
            </div>

            <div class="flex-1 min-w-[320px] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-xl">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Chi tiết thanh toán</h3>
                <div class="space-y-4">
                    <div class="flex justify-between border-b border-gray-200 dark:border-gray-700 pb-2">
                        <span class="text-gray-600 dark:text-gray-400">Giá vé gốc:</span>
                        <span id="basePrice" class="text-gray-900 dark:text-white font-medium">0 đ</span>
                    </div>
                    <div class="flex justify-between border-b border-gray-200 dark:border-gray-700 pb-2">
                        <span class="text-gray-600 dark:text-gray-400">Giảm giá:</span>
                        <span id="discountAmount" class="text-amber-600 dark:text-amber-400 font-medium">0 đ</span>
                    </div>
                    <div class="flex justify-between items-center bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-4 rounded-lg">
                        <span class="text-lg font-bold text-gray-900 dark:text-white">Tổng cộng:</span>
                        <span id="finalTotal" class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">0 đ</span>
                    </div>

                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mt-6 mb-4">Phương thức thanh toán</h3>
                    <div class="space-y-3">
                        <label
                            class="flex items-center p-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg cursor-pointer hover:border-amber-400">
                            <input type="radio" name="paymentMethod" value="Cash" checked
                                   class="text-amber-500 focus:ring-amber-400">
                            <span class="ml-3 text-gray-800 dark:text-white">Thanh toán tại quầy</span>
                        </label>
                        <label
                            class="flex items-center p-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg cursor-pointer hover:border-amber-400">
                            <input type="radio" name="paymentMethod" value="VNPAY" class="text-amber-500 focus:ring-amber-400">
                            <span class="ml-3 text-gray-800 dark:text-white">VNPAY (Quét mã QR)</span>
                        </label>
                        <label
                            class="flex items-center p-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg cursor-pointer hover:border-amber-400">
                            <input type="radio" name="paymentMethod" value="MOMO" class="text-amber-500 focus:ring-amber-400">
                            <span class="ml-3 text-gray-800 dark:text-white">MOMO (Quét mã QR)</span>
                        </label>
                        <label class="flex items-center p-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg cursor-pointer hover:border-amber-400">
                            <input type="radio" name="paymentMethod" value="PAYOS" class="text-amber-500 focus:ring-amber-400">
                            <span class="ml-3 text-gray-800 dark:text-white">Thanh toán chuyển khoản QR (PayOS)</span>
                        </label>
                    </div>
                    <button type="submit"
                            class="w-full mt-6 bg-amber-400 hover:bg-amber-500 text-gray-900 font-bold py-3 rounded-lg transition-all">
                        Xác nhận đặt vé
                    </button>
                </div>
            </div>

            <div class="flex-1 min-w-[320px] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-xl">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700 pb-3 mb-4">
                    Sơ đồ ma trận ghế thực tế
                </h2>
                <p id="lblBusType" class="text-sm font-bold text-amber-600 dark:text-amber-400 mb-3 text-center">-</p>
                <div id="grid-seats"
                     style="display: grid; width: 100% !important; grid-template-columns: repeat(4, 1fr); gap: 5px;"></div>
            </div>

        </form>
    </div>

</div>


<script>
    let selectedSeats = [];
    let cachedTrips = [];
    let currentTripBaseFare = 0;
    let ageDiscountRules = [];

    const container = document.getElementById('hidden-seats-container');
    const txtSeatNum = document.getElementById('txtSeatNum');
    const gridSeats = document.getElementById('grid-seats');
    const seatHoldCodeInput = document.getElementById('seatHoldCode');
    const seatHoldTimerText = document.getElementById('seatHoldTimerText');
    const seatHoldCountdown = document.getElementById('seatHoldCountdown');

    const SEAT_HOLD_STORAGE_KEY = 'SRC_TRAVEL_CURRENT_SEAT_HOLD_CODE';
    const PAYMENT_HOLD_MINUTES = 5;
    let currentSeatHoldCode = '';
    if (seatHoldCodeInput) seatHoldCodeInput.value = '';

    function saveSeatHoldCode(holdCode) {
        currentSeatHoldCode = holdCode || currentSeatHoldCode || '';

        if (currentSeatHoldCode) {
            sessionStorage.setItem(SEAT_HOLD_STORAGE_KEY, currentSeatHoldCode);
        }

        if (seatHoldCodeInput) {
            seatHoldCodeInput.value = currentSeatHoldCode || '';
        }
    }

    function clearSeatHoldCode() {
        currentSeatHoldCode = '';
        sessionStorage.removeItem(SEAT_HOLD_STORAGE_KEY);

        if (seatHoldCodeInput) {
            seatHoldCodeInput.value = '';
        }
    }

    let currentSeatHoldExpiresAt = null;
    let seatHoldTimerInterval = null;
    let isSubmittingBooking = false;

    const systemTrips = @Html.Raw(Json.Serialize(Model));

    document.addEventListener("DOMContentLoaded", function () {
        initAutocomplete('txtDeparture', 'dropDeparture');
        initAutocomplete('txtDestination', 'dropDestination');
        loadDiscountRules();
    });

    const phoneInput = document.getElementById('txtPassengerPhone');
    const nameInput = document.querySelector('input[name="passengerName"]');
    const emailInput = document.querySelector('input[name="passengerEmail"]');
    const dobInput = document.getElementById('inputDob');

    document.getElementById('txtPassengerPhone').addEventListener('blur', async function () {
        const phone = this.value.trim();
        if (phone.length < 9) return;

        try {
            const response = await fetch(`/Booking/GetCustomerByPhone?phone=${encodeURIComponent(phone)}`);

            if (response.ok) {
                const customer = await response.json();

                // Điền thông tin tự động nếu tìm thấy khách hàng cũ
                if (customer) {
                    document.getElementById('txtPassengerName').value = customer.fullName || '';
                    document.getElementById('txtPassengerEmail').value = customer.email || '';

                    if (customer.dob) {
                        document.getElementById('inputDob').value = customer.dob.split('T')[0];
                        calculateAge(); // Tính lại tuổi để áp dụng giảm giá
                    }
                }
            } else {
                // NẾU LÀ KHÁCH HÀNG MỚI: Giữ nguyên SĐT khách vừa nhập, không làm mất dữ liệu
                console.log("Đây là khách hàng mới, tiến hành nhập thủ công.");
            }
        } catch (err) {
            console.error("Lỗi khi kiểm tra số điện thoại:", err);
        }
    });

    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function updateSelectedSeatsDisplay() {
        txtSeatNum.innerText = selectedSeats.length > 0 ? selectedSeats.join(', ') : 'Chưa chọn';
        container.innerHTML = selectedSeats.map(s => `<input type="hidden" name="seatNumbers" value="${s}">`).join('');
        if (seatHoldCodeInput) seatHoldCodeInput.value = currentSeatHoldCode || '';
        updatePriceTable();
    }

    function formatTimeLeft(totalSeconds) {
        const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
        const seconds = Math.max(0, totalSeconds % 60).toString().padStart(2, '0');
        return `${minutes}:${seconds}`;
    }

    async function releaseCurrentSeatHoldBeforeReload() {
        const tripId = document.getElementById('hidTripId')?.value;
        if (!tripId || !currentSeatHoldCode) return;

        try {
            const formData = new FormData();
            formData.append('tripId', tripId);
            formData.append('holdCode', currentSeatHoldCode);

            await fetch('/Booking/ReleaseCurrentSeatSelection', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: formData
            });
        } catch (err) {
            console.warn('Không gọi được API nhả ghế trước khi reload:', err);
        }
    }

    function startSeatHoldCountdown(heldUntil) {
        currentSeatHoldExpiresAt = new Date(heldUntil);

        if (seatHoldTimerInterval) {
            clearInterval(seatHoldTimerInterval);
        }

        if (seatHoldTimerText) {
            seatHoldTimerText.classList.remove('hidden');
        }

        seatHoldTimerInterval = setInterval(async function () {
            if (isSubmittingBooking || !currentSeatHoldExpiresAt) return;

            const secondsLeft = Math.ceil((currentSeatHoldExpiresAt.getTime() - Date.now()) / 1000);

            if (seatHoldCountdown) {
                seatHoldCountdown.innerText = formatTimeLeft(Math.max(0, secondsLeft));
            }

            if (secondsLeft <= 0) {
                clearInterval(seatHoldTimerInterval);
                seatHoldTimerInterval = null;

                alert('Đã quá 5 phút nhưng chưa hoàn tất thanh toán. Hệ thống sẽ tải lại trang và nhả ghế đã giữ.');
                await releaseCurrentSeatHoldBeforeReload();
                clearSeatHoldCode();
                window.location.reload();
            }
        }, 1000);
    }

    function stopSeatHoldCountdownIfNoSeat() {
        if (seatHoldTimerInterval) {
            clearInterval(seatHoldTimerInterval);
            seatHoldTimerInterval = null;
        }

        currentSeatHoldExpiresAt = null;
        if (seatHoldTimerText) seatHoldTimerText.classList.add('hidden');
        if (seatHoldCountdown) seatHoldCountdown.innerText = '05:00';
    }

    function getSeatStatusMessage(seatNumber, seatInfo) {
        if (seatInfo?.isBooked) {
            return `Ghế ${seatNumber} đã được đặt. Vui lòng chọn ghế khác.`;
        }
        return `Ghế ${seatNumber} đang được người khác giữ. Vui lòng chọn ghế khác.`;
    }

    async function fetchTripSeatMap(tripId) {
        const holdQuery = currentSeatHoldCode
            ? '&holdCode=' + encodeURIComponent(currentSeatHoldCode)
            : '';
        const response = await fetch('@Url.Action("GetTripSeatMap", "Booking")?tripId=' + encodeURIComponent(tripId) + holdQuery);

        if (!response.ok) {
            throw new Error('Không thể tải sơ đồ ghế.');
        }

        const result = await response.json();
        return result.data || result;
    }

    function findSeatInMap(seatMapData, seatNumber) {
        return (seatMapData.seats || []).find(function (s) {
            return s.seatNumber === seatNumber;
        });
    }

    function isSeatUnavailable(seat) {
        if (!seat) return true;
        const heldByOther = seat.isHolding === true && seat.isHeldByMe !== true;
        return seat.isBooked === true || heldByOther;
    }

    async function verifySeatCanBeSelected(tripId, seatNumber) {
        try {
            const data = await fetchTripSeatMap(tripId);
            const seat = findSeatInMap(data, seatNumber);

            if (!seat) {
                return { ok: false, message: `Không tìm thấy thông tin ghế ${seatNumber}.` };
            }

            if (isSeatUnavailable(seat)) {
                return { ok: false, message: getSeatStatusMessage(seatNumber, seat) };
            }

            return { ok: true };
        } catch (err) {
            console.error(err);
            return { ok: false, message: 'Không thể kiểm tra trạng thái ghế. Vui lòng thử lại.' };
        }
    }

    async function validateSelectedSeatsBeforeSubmit(tripId) {
        try {
            const data = await fetchTripSeatMap(tripId);

            for (const seatNumber of selectedSeats) {
                const seat = findSeatInMap(data, seatNumber);
                if (isSeatUnavailable(seat)) {
                    return { ok: false, message: getSeatStatusMessage(seatNumber, seat) };
                }
            }

            return { ok: true };
        } catch (err) {
            console.error(err);
            return { ok: false, message: 'Không thể kiểm tra trạng thái ghế. Vui lòng thử lại.' };
        }
    }

    async function parseBookingResponse(response) {
        const rawText = await response.text();
        if (!rawText) {
            return { success: false, message: 'Máy chủ không trả về dữ liệu.' };
        }

        try {
            return JSON.parse(rawText);
        } catch (parseError) {
            console.error(parseError, rawText);
            return { success: false, message: 'Máy chủ trả về dữ liệu không hợp lệ.' };
        }
    }

    async function toggleSeat(btn, seatNumber, isLocked, seatInfo) {
        const tripId = document.getElementById('hidTripId')?.value;
        if (!tripId) {
            alert('Vui lòng chọn chuyến xe trước khi chọn ghế.');
            return;
        }

        if (isLocked) {
            alert(getSeatStatusMessage(seatNumber, seatInfo));
            await loadSeatMatrix(tripId);
            return;
        }

        const seatIndex = selectedSeats.indexOf(seatNumber);

        if (seatIndex > -1) {
            selectedSeats.splice(seatIndex, 1);
            btn.classList.remove('bg-amber-500', 'text-black', 'border-amber-400');
            btn.classList.add('admin-seat-btn');
            btn.innerText = seatNumber;
            updateSelectedSeatsDisplay();
            return;
        }

        btn.disabled = true;
        const originalText = btn.innerText;
        btn.innerText = '...';

        try {
            const check = await verifySeatCanBeSelected(tripId, seatNumber);
            if (!check.ok) {
                alert(check.message);
                await loadSeatMatrix(tripId);
                return;
            }

            selectedSeats.push(seatNumber);
            btn.classList.add('bg-amber-500', 'text-black', 'border-amber-400');
            btn.classList.remove('admin-seat-btn');
            btn.innerText = `${seatNumber}✓`;
            updateSelectedSeatsDisplay();
        } catch (err) {
            console.error(err);
            alert('Không thể kiểm tra trạng thái ghế. Vui lòng thử lại.');
            await loadSeatMatrix(tripId);
        } finally {
            btn.disabled = false;
            if (!selectedSeats.includes(seatNumber)) {
                btn.innerText = originalText.replace('✓', '');
            }
        }
    }

    phoneInput.addEventListener('blur', async function () {
        const phone = this.value.trim();
        if (phone.length < 9) return;

        try {
            // Hãy mở F12 -> Tab Network để xem link này có trả về 404 hay 200 không
            const response = await fetch(`/Booking/GetCustomerByPhone?phone=${encodeURIComponent(phone)}`);

            if (response.ok) {
                const customer = await response.json();

                // Điền thông tin vào các input
                document.getElementById('txtPassengerName').value = customer.fullName || '';
                document.getElementById('txtPassengerEmail').value = customer.email || '';

                if (customer.dob) {
                    // Định dạng ngày cho input date là YYYY-MM-DD
                    document.getElementById('inputDob').value = customer.dob.split('T')[0];
                    calculateAge(); // Tính tuổi ngay sau khi có ngày sinh
                    updatePriceTable(); // Cập nhật lại bảng giá
                }
            } else {
                console.log("Không tìm thấy khách hàng này trong hệ thống.");
            }
        } catch (err) {
            console.error("Lỗi khi fetch dữ liệu khách hàng:", err);
        }
    });

    async function loadDiscountRules() {
        try {
            const response = await fetch('/Booking/GetDiscountRules');
            const data = await response.json();
            ageDiscountRules = data.rules || [];
        } catch (err) {
            console.error("Lỗi tải quy tắc giảm giá:", err);
        }
    }

    function getDiscountPercentage(age) {
        const rule = ageDiscountRules.find(r => age >= r.minAge && age <= r.maxAge);
        return rule ? rule.discountPercentage : 0;
    }

    function updatePriceTable() {
        const seatCount = selectedSeats.length;
        const age = parseInt(document.getElementById('displayAge').innerText) || 0;
        const rule = ageDiscountRules.find(r => age >= r.minAge && age <= r.maxAge);
        const discountPercent = rule ? (rule.discountPercentage / 100) : 0;
        const basePrice = seatCount * currentTripBaseFare;
        const discountAmount = basePrice * discountPercent;
        const finalTotal = basePrice - discountAmount;

        document.getElementById('basePrice').innerText = basePrice.toLocaleString('vi-VN') + ' đ';
        document.getElementById('discountAmount').innerText = discountAmount.toLocaleString('vi-VN') + ' đ';
        document.getElementById('finalTotal').innerText = finalTotal.toLocaleString('vi-VN') + ' đ';
    }

    function calculateAge() {
        const dobVal = document.getElementById('inputDob').value;
        if (!dobVal) return;
        const dob = new Date(dobVal);
        const today = new Date();
        let age = today.getFullYear() - dob.getFullYear();
        const m = today.getMonth() - dob.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;

        document.getElementById('displayAge').innerText = age >= 0 ? age : 0;
        updatePriceTable();
    }

    function initAutocomplete(inputId, dropId) {
        const input = document.getElementById(inputId);
        const dropdown = document.getElementById(dropId);
        if (!input || !dropdown) return;

        input.addEventListener("focus", function () {
            fetchSuggestions(input, dropdown, "");
        });
        input.addEventListener("input", function () {
            fetchSuggestions(input, dropdown, input.value);
        });

        document.addEventListener("click", function (e) {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add("hidden");
            }
        });
    }

    async function fetchSuggestions(input, dropdown, keyword) {
        try {
            const response = await fetch('/Booking/GetLocationSuggestions?keyword=' + encodeURIComponent(keyword));
            if (!response.ok) return;
            const locations = await response.json();

            if (locations.length === 0) {
                dropdown.innerHTML = '<div class="p-3 text-gray-400 italic">Không tìm thấy địa điểm...</div>';
                dropdown.classList.remove("hidden");
                return;
            }

            dropdown.innerHTML = '';
            dropdown.classList.remove("hidden");

            const groups = {};
            locations.forEach(function (loc) {
                if (!groups[loc.type]) groups[loc.type] = [];
                groups[loc.type].push(loc.name);
            });

            for (const [type, items] of Object.entries(groups)) {
                const header = document.createElement("div");
                header.className = "bg-gray-100 text-gray-500 px-3 py-1.5 font-bold text-[10px] uppercase tracking-wider";
                header.innerText = type;
                dropdown.appendChild(header);

                items.forEach(function (name) {
                    const row = document.createElement("div");
                    row.className = "px-3 py-2 hover:bg-amber-50 cursor-pointer flex items-center text-gray-700 font-medium transition-colors";
                    row.innerHTML = '<span class="text-gray-400 mr-2">📍</span>' + name;

                    row.addEventListener("click", function () {
                        input.value = name;
                        dropdown.classList.add("hidden");
                    });
                    dropdown.appendChild(row);
                });
            }
        } catch (err) {
            console.error("Lỗi autocomplete:", err);
        }
    }

    async function searchTripsByRoute() {
        const dep = document.getElementById('txtDeparture').value.trim();
        const dest = document.getElementById('txtDestination').value.trim();
        const date = document.getElementById('txtTravelDate').value;
        const area = document.getElementById('searchResultArea');

        const bookingDetail = document.getElementById('bookingDetailSection');
        if (bookingDetail) bookingDetail.classList.add('hidden');

        if (!dep || !dest || !date) {
            alert("Vui lòng nhập đầy đủ thông tin tìm kiếm!");
            return;
        }

        if (area) {
            area.innerHTML = '<p class="text-xs text-gray-500 dark:text-gray-400 col-span-full text-center py-6">🔍 Đang tìm kiếm chuyến xe phù hợp...</p>';
        }

        try {
            const url = `/Booking/SearchTrips?departure=${encodeURIComponent(dep)}&destination=${encodeURIComponent(dest)}&date=${encodeURIComponent(date)}`;
            const response = await fetch(url);
            if (!response.ok) throw new Error("Lỗi mạng");

            cachedTrips = await response.json();
            renderFilteredTrips();

        } catch (err) {
            console.error(err);
            if (area) area.innerHTML = '<p class="text-xs text-rose-400 col-span-full text-center py-6">Không thể tải dữ liệu chuyến xe.</p>';
        }
    }

    function renderFilteredTrips() {
        const area = document.getElementById('searchResultArea');
        if (!area) return;

        const dep = document.getElementById('txtDeparture').value.trim();
        const dest = document.getElementById('txtDestination').value.trim();

        if (cachedTrips.length === 0) {
            area.innerHTML = '<p class="text-xs text-rose-400 col-span-full text-center py-6">Không có chuyến xe nào chạy tuyến đường này trong ngày.</p>';
            return;
        }

        const sortRadio = document.querySelector('input[name="tripSort"]:checked');
        const sortValue = sortRadio ? sortRadio.value : "default";
        let displayTrips = [...cachedTrips];

        if (sortValue === "timeAsc") {
            displayTrips.sort((a, b) => new Date(a.departureTime) - new Date(b.departureTime));
        } else if (sortValue === "priceAsc") {
            displayTrips.sort((a, b) => a.baseFare - b.baseFare);
        } else if (sortValue === "priceDesc") {
            displayTrips.sort((a, b) => b.baseFare - a.baseFare);
        }

        area.innerHTML = '';

        displayTrips.forEach(function (trip) {
            const card = document.createElement('div');
            card.className = "bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-amber-400 transition-all cursor-pointer shadow-xl flex overflow-hidden group min-h-[140px]";

            const dTime = new Date(trip.departureTime);
            const timeStr = dTime.toLocaleTimeString('vi-VN', {hour: '2-digit', minute: '2-digit'});
            const fareStr = Number(trip.baseFare).toLocaleString('vi-VN') + " đ";

            let busImgUrl = "https://images.unsplash.com/photo-1570125909232-eb263c188f7e?auto=format&fit=crop&q=80&w=400";
            if (trip.busType && (trip.busType.includes("Giường") || trip.busType.includes("Limousine"))) {
                busImgUrl = "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80&w=400";
            }
            
            card.innerHTML = `
    <div class="admin-trip-card-media w-1/3 max-w-[150px] relative overflow-hidden flex-shrink-0">
        <img src="${busImgUrl}" alt="Ảnh xe" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
    </div>

    <div class="w-2/3 flex-1 p-4 flex flex-col justify-between space-y-2">
        <div class="flex justify-between items-start gap-1">
            <div class="flex flex-col gap-1 min-w-0">
                <span class="admin-trip-card-badge text-[10px] px-2 py-0.5 rounded font-bold tracking-wider truncate">
                    🚌 ${trip.licensePlate || trip.busCode} (${trip.busType || 'Ghế ngồi'})
                </span>
                <span class="text-[10px] text-gray-600 dark:text-gray-400 font-semibold px-2">
                     🏢 Nhà xe: <span class="text-gray-900 dark:text-white font-bold">${trip.operatorName || 'Chưa xác định'}</span>
                </span>
            </div>
            <span class="text-sm font-black text-emerald-600 dark:text-emerald-400 whitespace-nowrap">${fareStr}</span>
        </div>
        
        <div class="flex items-center justify-between gap-2">
            <div class="text-gray-900 dark:text-white font-bold text-base">
                🕒 Giờ chạy: <span class="text-amber-600 dark:text-amber-400">${timeStr}</span>
            </div>
            <div class="admin-trip-card-seats text-[10px] px-1.5 py-0.5 rounded border whitespace-nowrap">
                🪑 Trống: <span class="text-emerald-600 dark:text-emerald-400 font-bold">${trip.availableSeats ?? 0}</span> chỗ
            </div>
        </div>

        <div class="admin-trip-card-route text-[11px] flex items-center justify-between p-2 rounded border gap-1">
            <span class="truncate text-gray-700 dark:text-gray-400">🔵 ${dep}</span>
            <span class="text-gray-400 dark:text-gray-600 font-bold">➔</span>
            <span class="truncate text-right text-gray-700 dark:text-gray-400">📍 ${dest}</span>
        </div>
    </div>
`;

            card.addEventListener('click', async function () {
                const hidTripId = document.getElementById('hidTripId');
                const oldTripId = hidTripId?.value;

                if (oldTripId && oldTripId !== trip.id) {
                    if (currentSeatHoldCode) {
                        await releaseCurrentSeatHoldBeforeReload();
                        clearSeatHoldCode();
                    }
                    selectedSeats = [];
                    updateSelectedSeatsDisplay();
                    stopSeatHoldCountdownIfNoSeat();
                }

                document.querySelectorAll('#searchResultArea > div').forEach(c => {
                    c.classList.remove('border-amber-400', 'bg-amber-400/5');
                });
                card.classList.add('border-amber-400', 'bg-amber-400/5');

                if (hidTripId) hidTripId.value = trip.id;

                const lblBusType = document.getElementById('lblBusType');
                if (lblBusType) lblBusType.innerText = `SƠ ĐỒ XE: ${trip.licensePlate || trip.busCode} (${trip.busType})`;

                const detailSection = document.getElementById('bookingDetailSection');
                if (detailSection) detailSection.classList.remove('hidden');
                currentTripBaseFare = trip.baseFare;
                updatePriceTable();
                loadSeatMatrix(trip.id);
            });

            area.appendChild(card);
        });

        if (window.tailwind && typeof window.tailwind.refresh === 'function') {
            window.tailwind.refresh();
        }
    }

    // MAP CHUẨN XÁC VÀO THE GRID SEATS CỦA FILE HTML
    async function loadSeatMatrix(tripId) {
        if (!gridSeats) return;

        gridSeats.innerHTML = '<p class="text-xs text-amber-400"> Đang tải sơ đồ...</p>';
        const previousSelected = [...selectedSeats];

        try {
            const holdQuery = currentSeatHoldCode
                ? '&holdCode=' + encodeURIComponent(currentSeatHoldCode)
                : '';
            const response = await fetch('@Url.Action("GetTripSeatMap", "Booking")?tripId=' + encodeURIComponent(tripId) + holdQuery);

            if (!response.ok) {
                throw new Error('Không thể kết nối server');
            }

            const result = await response.json();
            const data = result.data || result;

            gridSeats.innerHTML = '';

            if (data.holdCode || currentSeatHoldCode) {
                saveSeatHoldCode(data.holdCode || currentSeatHoldCode);
            }

            selectedSeats = previousSelected.filter(function (seatNum) {
                const seat = (data.seats || []).find(function (s) {
                    return s.seatNumber === seatNum;
                });
                if (!seat) return false;
                const heldByOther = seat.isHolding === true && seat.isHeldByMe !== true;
                return !seat.isBooked && !heldByOther;
            });

            const totalCols = data.cols || 4;

            gridSeats.style.display = 'grid';
            gridSeats.style.gridTemplateColumns = `repeat(${totalCols}, minmax(40px, 1fr))`;
            gridSeats.style.gap = '8px';

            let myLatestHeldUntil = null;

            // Render ghế
            data.seats.forEach(function (seat) {
                const btn = document.createElement('button');
                btn.type = "button";

                const isHeldByMe = seat.isHeldByMe === true;
                const heldByOther = seat.isHolding === true && !isHeldByMe;
                const isLocallySelected = selectedSeats.includes(seat.seatNumber);

                if (heldByOther || seat.isBooked) {
                    const staleIndex = selectedSeats.indexOf(seat.seatNumber);
                    if (staleIndex > -1) {
                        selectedSeats.splice(staleIndex, 1);
                    }
                }

                const isSelected = (isHeldByMe || isLocallySelected) && !heldByOther && !seat.isBooked;
                const isLocked = seat.isBooked || heldByOther || (seat.isLocked && !isHeldByMe);

                if (isHeldByMe) {
                    if (!selectedSeats.includes(seat.seatNumber)) {
                        selectedSeats.push(seat.seatNumber);
                    }
                    if (seat.heldUntil) {
                        const heldUntilDate = new Date(seat.heldUntil);
                        if (!myLatestHeldUntil || heldUntilDate > myLatestHeldUntil) {
                            myLatestHeldUntil = heldUntilDate;
                        }
                    }
                }

                btn.className = `h-8 w-10 text-[10px] font-bold rounded border flex items-center justify-center transition-all ${
                    isSelected
                        ? "bg-amber-500 border-amber-400 text-black cursor-pointer"
                        : isLocked
                            ? "bg-gray-200 dark:bg-black border-gray-300 dark:border-gray-800 text-gray-600 dark:text-gray-500 opacity-90 grayscale cursor-pointer"
                            : "admin-seat-btn hover:border-amber-400 cursor-pointer"
                }`;

                btn.innerText = isSelected
                    ? `${seat.seatNumber}✓`
                    : seat.isHolding
                        ? `${seat.seatNumber}⏳`
                        : seat.seatNumber;

                if (seat.isBooked) {
                    btn.title = "Ghế đã được đặt";
                } else if (isSelected) {
                    btn.title = "Ghế bạn đang chọn. Bấm lại để bỏ chọn.";
                } else if (seat.isHolding) {
                    btn.title = "Ghế đang được người khác giữ chỗ";
                } else {
                    btn.title = "Ghế còn trống";
                }

                btn.onclick = function () {
                    toggleSeat(btn, seat.seatNumber, isLocked, seat);
                };

                gridSeats.appendChild(btn);
            });

            updateSelectedSeatsDisplay();

            if (myLatestHeldUntil) {
                startSeatHoldCountdown(myLatestHeldUntil);
            } else {
                stopSeatHoldCountdownIfNoSeat();
            }
        } catch (err) {
            console.error(err);
            gridSeats.innerHTML = '<p class="text-xs text-rose-400">Lỗi tải dữ liệu.</p>';
        }
    }

    function clearBookingData() {
        const form = document.getElementById('formBooking');
        if (form) form.reset();

        const hidTripId = document.getElementById('hidTripId');
        if (hidTripId) hidTripId.value = '';

        document.getElementById('txtDeparture').value = '';
        document.getElementById('txtDestination').value = '';
        if (txtSeatNum) txtSeatNum.innerText = 'Chưa chọn';
        if (container) container.innerHTML = '';
        selectedSeats.length = 0;
        stopSeatHoldCountdownIfNoSeat();

        const resultArea = document.getElementById('searchResultArea');
        if (resultArea) resultArea.innerHTML = '';

        const detailSection = document.getElementById('bookingDetailSection');
        if (detailSection) detailSection.classList.add('hidden');
    }

    const bookingForm = document.getElementById('formBooking');
    if (bookingForm) {
        bookingForm.addEventListener('submit', async function (e) {
            // 1. Chặn submit mặc định
            e.preventDefault();

            // 2. Validate dữ liệu phía Client
            const hidTripId = document.getElementById('hidTripId');
            if (!hidTripId || !hidTripId.value) {
                alert('Vui lòng chọn một chuyến xe trước!');
                return;
            }
            if (selectedSeats.length === 0) {
                alert('Vui lòng chọn ít nhất một chỗ ngồi!');
                return;
            }

            // 3. Kiểm tra ghế còn trống trước khi gửi — tránh báo lỗi kết nối chung chung
            const seatCheck = await validateSelectedSeatsBeforeSubmit(hidTripId.value);
            if (!seatCheck.ok) {
                alert(seatCheck.message);
                await loadSeatMatrix(hidTripId.value);
                return;
            }

            isSubmittingBooking = true;
            const formData = new FormData(this);
            formData.set('seatHoldCode', '');

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    body: formData
                });

                const result = await parseBookingResponse(response);

                if (result.success) {
                    // Nếu Backend trả về link thanh toán (VNPAY hoặc MoMo)
                    if (result.paymentUrl) {
                        if (result.heldUntil) {
                            startSeatHoldCountdown(result.heldUntil);
                        }

                        const isMomo = result.paymentUrl.includes("momo.vn");
                        const isPayOS = result.paymentUrl.includes("pay.payos.vn");
                        const titleWindow = isMomo ? "MOMOPayment" : (isPayOS ? "PAYOSPayment" : "VNPAYPayment");

                        const paymentWindow = window.open(
                            result.paymentUrl,
                            titleWindow,
                            "width=1100,height=800,left=100,top=50"
                        );

                        let paymentTimeLeft = (result.holdMinutes || PAYMENT_HOLD_MINUTES) * 60;

                        const paymentTimer = setInterval(function () {
                            paymentTimeLeft--;

                            // Nếu user thanh toán xong hoặc đóng cửa sổ
                            if (paymentWindow && paymentWindow.closed) {
                                clearInterval(paymentTimer);

                                // Load lại ma trận ghế và reload trang để cập nhật trạng thái mới nhất
                                alert("Đang kiểm tra trạng thái giao dịch...");
                                window.location.reload();
                                return;
                            }

                            if (paymentTimeLeft <= 0) {
                                clearInterval(paymentTimer);

                                if (paymentWindow && !paymentWindow.closed) {
                                    paymentWindow.close();
                                }

                                alert("Quá thời gian thanh toán 5 phút. Ghế giữ chỗ đã được mở lại. Trang sẽ được tải lại để cập nhật trạng thái ghế.");
                                window.location.reload();
                            }
                        }, 1000);

                    } else if (result.redirectUrl) {
                        // Dùng cho phương thức Thanh toán tại quầy (Cash)
                        window.location.href = result.redirectUrl;
                    }
                } else {
                    isSubmittingBooking = false;
                    const message = result.message || 'Có lỗi xảy ra.';
                    const isSeatConflict = /giữ|giu|đặt|dat|holding|booked/i.test(message);
                    alert(isSeatConflict ? message : ('Thất bại! ' + message));
                    const tripId = document.getElementById('hidTripId')?.value;
                    if (tripId) {
                        await loadSeatMatrix(tripId);
                    }
                }
            } catch (err) {
                isSubmittingBooking = false;
                console.error(err);
                alert('Không thể kết nối đến máy chủ. Vui lòng thử lại sau.');
            }
        });
    }
</script>