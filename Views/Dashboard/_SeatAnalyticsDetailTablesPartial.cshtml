@model IEnumerable<Bus_ticket.ViewModels.SeatAnalyticsViewModel>

@{
    var items = Model?.ToList() ?? new List<Bus_ticket.ViewModels.SeatAnalyticsViewModel>();
    var routeFilterOptions = ViewBag.RouteFilterOptions as List<string> ?? new List<string>();
    var routeNameFilter = ViewBag.RouteNameFilter as string ?? string.Empty;
    var licensePlateFilter = ViewBag.LicensePlateFilter as string ?? string.Empty;
    var hasTableFilters = !string.IsNullOrWhiteSpace(routeNameFilter) || !string.IsNullOrWhiteSpace(licensePlateFilter);
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
    <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-4">
            <div>
                <h3 class="text-md font-semibold text-gray-900 dark:text-white">Danh sách chi tiết tỷ lệ lấp đầy ghế</h3>
                <p class="text-xs text-gray-500 mt-1">Sắp xếp giảm dần theo tỷ lệ lấp đầy — @items.Count.ToString("N0") chuyến</p>
            </div>
            @if (routeFilterOptions.Any())
            {
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label for="seatAnalyticsRouteFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tuyến đường</label>
                        <select id="seatAnalyticsRouteFilter"
                                class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[240px] p-2 shadow-sm">
                            <option value="">Tất cả tuyến</option>
                            @foreach (var route in routeFilterOptions)
                            {
                                if (string.Equals(route, routeNameFilter, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@route" selected="selected">@route</option>
                                }
                                else
                                {
                                    <option value="@route">@route</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label for="seatAnalyticsLicensePlateFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Biển số xe</label>
                        <input type="text"
                               id="seatAnalyticsLicensePlateFilter"
                               value="@licensePlateFilter"
                               placeholder="Tìm biển số..."
                               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[160px] p-2 shadow-sm" />
                    </div>
                    <button type="button"
                            onclick="applySeatAnalyticsTableFilters()"
                            class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
                        Tìm kiếm
                    </button>
                    @if (hasTableFilters)
                    {
                        <button type="button"
                                onclick="clearSeatAnalyticsTableFilters()"
                                class="px-3 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
                            Xóa lọc bảng
                        </button>
                    }
                </div>
            }
        </div>
    </div>
    <div class="overflow-x-auto max-h-[520px]">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10">
            <tr>
                <th class="px-6 py-4">Mã chuyến</th>
                <th class="px-6 py-4">Tuyến đường</th>
                <th class="px-6 py-4">Biển số</th>
                <th class="px-6 py-4">Giờ xuất phát</th>
                <th class="px-6 py-4 text-right">Ghế đã đặt</th>
                <th class="px-6 py-4 text-right">Tổng ghế</th>
                <th class="px-6 py-4 text-right">Tỷ lệ lấp đầy</th>
                <th class="px-6 py-4 text-center">Trạng thái</th>
            </tr>
            </thead>
            <tbody>
            @if (!items.Any())
            {
                <tr><td colspan="8" class="px-6 py-10 text-center text-gray-500">Không có dữ liệu hiển thị.</td></tr>
            }
            else
            {
                foreach (var item in items)
                {
                    var rateClass = item.OccupancyRate >= 80
                        ? "text-emerald-600 dark:text-emerald-400"
                        : item.OccupancyRate >= 50
                            ? "text-amber-600 dark:text-amber-400"
                            : "text-red-600 dark:text-red-400";

                    var badgeClass = item.OccupancyRate >= 80
                        ? "text-emerald-700 bg-emerald-100 dark:text-emerald-300 dark:bg-emerald-900/50 border-emerald-200 dark:border-emerald-700"
                        : item.OccupancyRate >= 50
                            ? "text-amber-700 bg-amber-100 dark:text-amber-300 dark:bg-amber-900/50 border-amber-200 dark:border-amber-700"
                            : "text-red-700 bg-red-100 dark:text-red-300 dark:bg-red-900/50 border-red-200 dark:border-red-700";

                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                        <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">@item.TripCode</td>
                        <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">@item.RouteName</td>
                        <td class="px-6 py-4">@item.LicensePlate</td>
                        <td class="px-6 py-4 whitespace-nowrap">@item.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-6 py-4 text-right">@item.BookedSeats.ToString("N0")</td>
                        <td class="px-6 py-4 text-right">@item.TotalSeats.ToString("N0")</td>
                        <td class="px-6 py-4 text-right font-bold @rateClass">@item.OccupancyRate.ToString("N2")%</td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex rounded-full border px-3 py-1 text-xs font-bold @badgeClass">
                                @(item.OccupancyRate >= 80 ? "Cao" : item.OccupancyRate >= 50 ? "Ổn định" : "Thấp")
                            </span>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
