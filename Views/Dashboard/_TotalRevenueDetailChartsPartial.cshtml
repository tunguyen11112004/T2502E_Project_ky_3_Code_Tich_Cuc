@model Bus_ticket.ViewModels.DashboardRevenueViewModel

@{
    var paymentSummaries = PaymentMethodDisplayHelper.BuildSummaries(Model?.TableData);
    var paymentChartData = PaymentMethodDisplayHelper.BuildChartData(paymentSummaries);

    var fromDate = DateTime.TryParse(ViewBag.FromDateValue as string, out var parsedFrom)
        ? parsedFrom.Date
        : DateTime.Today.AddDays(-30);
    var toDate = DateTime.TryParse(ViewBag.ToDateValue as string, out var parsedTo)
        ? parsedTo.Date
        : DateTime.Today;

    var periodGrouping = RevenuePeriodGroupingHelper.Build(Model?.TableData, fromDate, toDate);
    var lineLabels = periodGrouping.ChartGroups.Select(x => x.DisplayLabel).ToList();
    var lineValues = periodGrouping.ChartGroups.Select(x => x.Revenue).ToList();
    var lineQueryDates = periodGrouping.ChartGroups.Select(x => $"{x.QueryStartDate}|{x.QueryEndDate}").ToList();
    var labelsSeat = Model?.ChartData.Select(c => c.Category).ToList() ?? new List<string>();
    var dataSeat = Model?.ChartData.Select(c => c.TotalRevenue).ToList() ?? new List<decimal>();
    var busClassPalette = new[] { "#8b5cf6", "#10b981", "#0ea5e9", "#f59e0b", "#ef4444", "#6b7280" };
    var colorsSeat = labelsSeat.Select((_, index) => busClassPalette[index % busClassPalette.Length]).ToList();

    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
    var busClassFilter = ViewBag.BusClassFilter as string ?? string.Empty;
    var routeNameFilter = ViewBag.RouteNameFilter as string ?? string.Empty;
    var paymentMethodFilter = ViewBag.PaymentMethodFilter as string ?? string.Empty;
}

<div id="totalRevenueDetailCharts" class="hidden space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm w-full">
        <div class="mb-4">
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">@periodGrouping.ChartTitle</h3>
            <p class="text-xs text-gray-500 mt-1">@periodGrouping.ChartSubtitle</p>
        </div>
        <div class="relative h-[320px] w-full flex justify-center">
            <canvas id="detailRevenueLineChart"></canvas>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
            <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-1">Tỷ trọng theo Hạng Xe</h3>
            <p class="text-xs text-gray-500 mb-4">Click legend để ẩn/hiện trên bảng bên dưới · Click biểu đồ để lọc theo hạng xe</p>
            <div class="relative h-[280px] w-full flex justify-center">
                <canvas id="detailTotalRevenueChart"></canvas>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
            <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-1">Theo phương thức thanh toán</h3>
            <p class="text-xs text-gray-500 mb-4">Click legend để ẩn/hiện trên bảng bên dưới · Click biểu đồ để lọc theo phương thức thanh toán</p>
            <div class="relative h-[280px] w-full flex justify-center">
                <canvas id="detailPaymentMethodChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    window.totalRevenueDetailChartData = {
        lineLabels: @Html.Raw(Json.Serialize(lineLabels)),
        lineValues: @Html.Raw(Json.Serialize(lineValues)),
        lineQueryDates: @Html.Raw(Json.Serialize(lineQueryDates)),
        labelsSeat: @Html.Raw(Json.Serialize(labelsSeat)),
        dataSeat: @Html.Raw(Json.Serialize(dataSeat)),
        colorsSeat: @Html.Raw(Json.Serialize(colorsSeat)),
        labelsPayment: @Html.Raw(Json.Serialize(paymentChartData.Labels)),
        dataPayment: @Html.Raw(Json.Serialize(paymentChartData.Values)),
        colorsPayment: @Html.Raw(Json.Serialize(paymentChartData.Colors)),
        fromDate: @Html.Raw(Json.Serialize(fromDateValue)),
        toDate: @Html.Raw(Json.Serialize(toDateValue)),
        busClass: @Html.Raw(Json.Serialize(busClassFilter)),
        routeName: @Html.Raw(Json.Serialize(routeNameFilter)),
        paymentMethod: @Html.Raw(Json.Serialize(paymentMethodFilter))
    };

    window.totalRevenueDetailChartsInitialized = false;

    function renderDetailPieChart(chartId, labels, data, colors, labelText, onSliceClick, enableTableFilter) {
        const canvas = document.getElementById(chartId);
        if (!canvas || typeof Chart === 'undefined') return;

        window.detailCharts = window.detailCharts || {};

        if (window.detailCharts[chartId]) {
            window.detailCharts[chartId].destroy();
            delete window.detailCharts[chartId];
        }

        const numericData = (data || []).map(v => Number(v || 0));
        if (!numericData.some(v => v > 0)) return;

        const isDark = document.documentElement.classList.contains('dark');
        const legendColor = isDark ? '#d1d5db' : '#4b5563';
        const chartColors = (colors && colors.length > 0)
            ? colors
            : ['#8b5cf6', '#10b981', '#0ea5e9', '#f59e0b', '#ef4444', '#6b7280'];

        const legendOptions = {
            position: 'bottom',
            labels: { color: legendColor, boxWidth: 12, padding: 12 }
        };

        if (enableTableFilter && typeof window.createRevenuePieLegendClickHandler === 'function') {
            legendOptions.onClick = window.createRevenuePieLegendClickHandler();
        }

        const piePlugins = window.pieChartExternalLabelPlugin ? [window.pieChartExternalLabelPlugin] : [];

        window.detailCharts[chartId] = new Chart(canvas.getContext('2d'), {
            type: 'pie',
            plugins: piePlugins,
            data: {
                labels,
                datasets: [{
                    label: labelText,
                    data: numericData,
                    backgroundColor: chartColors,
                    borderWidth: 1,
                    borderColor: isDark ? '#1f2937' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: typeof window.getPieChartLayoutPadding === 'function'
                    ? { padding: window.getPieChartLayoutPadding() }
                    : undefined,
                plugins: {
                    legend: legendOptions,
                    tooltip: {
                        callbacks: {
                            label: typeof window.createPieChartTooltipLabel === 'function'
                                ? window.createPieChartTooltipLabel(' đ')
                                : function (context) {
                                    const value = Number(context.raw || 0);
                                    return `${context.label}: ${value.toLocaleString('vi-VN')} đ`;
                                }
                        }
                    }
                },
                onClick: function (event, elements) {
                    if (elements.length > 0 && typeof onSliceClick === 'function') {
                        const url = onSliceClick(elements[0].index, labels);
                        if (url) {
                            window.location.href = url;
                        }
                    }
                },
                onHover: function (event, elements) {
                    if (typeof onSliceClick === 'function') {
                        event.native.target.style.cursor = elements.length ? 'pointer' : 'default';
                    }
                }
            }
        });

        if (enableTableFilter && typeof applyRevenueChartTableFilters === 'function') {
            applyRevenueChartTableFilters();
        }
    }

    function buildTotalRevenueDetailUrl(fromDate, toDate, busClass, routeName, paymentMethod) {
        const params = new URLSearchParams();
        params.set('fromDate', fromDate);
        params.set('toDate', toDate);
        if (routeName) {
            params.set('routeName', routeName);
        }
        if (busClass) {
            params.set('busClass', busClass);
        }
        if (paymentMethod) {
            params.set('paymentMethod', paymentMethod);
        }
        return `/Dashboard/TotalRevenueDetail?${params.toString()}`;
    }

    function initializeTotalRevenueDetailCharts() {
        if (window.totalRevenueDetailChartsInitialized) return;

        const data = window.totalRevenueDetailChartData;
        if (!data) return;

        renderDetailPieChart('detailTotalRevenueChart', data.labelsSeat, data.dataSeat, data.colorsSeat, 'Tổng Doanh Thu', function (index, chartLabels) {
            const busClass = chartLabels[index];
            if (!busClass) return null;
            return buildTotalRevenueDetailUrl(data.fromDate, data.toDate, busClass, data.routeName || '', data.paymentMethod || '');
        }, true);
        renderDetailPieChart('detailPaymentMethodChart', data.labelsPayment, data.dataPayment, data.colorsPayment, 'Thanh toán', function (index, chartLabels) {
            const paymentMethod = chartLabels[index];
            if (!paymentMethod) return null;
            return buildTotalRevenueDetailUrl(data.fromDate, data.toDate, data.busClass || '', data.routeName || '', paymentMethod);
        }, true);

        const lineCanvas = document.getElementById('detailRevenueLineChart');
        if (lineCanvas && typeof Chart !== 'undefined') {
            window.detailCharts = window.detailCharts || {};

            if (window.detailCharts.detailRevenueLineChart) {
                window.detailCharts.detailRevenueLineChart.destroy();
            }

            window.detailCharts.detailRevenueLineChart = new Chart(lineCanvas.getContext('2d'), {
                type: 'line',
                data: {
                    labels: data.lineLabels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: data.lineValues,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        borderWidth: 2,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#10b981',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    const value = context.raw || 0;
                                    return 'Doanh thu: ' + Number(value).toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    if (value >= 1000000) return (value / 1000000) + ' Tr';
                                    if (value >= 1000) return (value / 1000) + ' K';
                                    return value;
                                }
                            }
                        }
                    },
                    onClick: function (event, elements) {
                        if (elements.length > 0) {
                            const index = elements[0].index;
                            const dates = data.lineQueryDates[index].split('|');
                            const url = buildTotalRevenueDetailUrl(dates[0], dates[1], data.busClass || '', data.routeName || '', data.paymentMethod || '');
                            window.location.href = url;
                        }
                    },
                    onHover: function (event, elements) {
                        event.native.target.style.cursor = elements.length ? 'pointer' : 'default';
                    }
                }
            });
        }

        window.totalRevenueDetailChartsInitialized = true;
    }

    function toggleTotalRevenueDetailCharts(button) {
        const section = document.getElementById('totalRevenueDetailCharts');
        if (!section) return;

        const willShow = section.classList.contains('hidden');
        section.classList.toggle('hidden', !willShow);

        const label = button?.querySelector('[data-chart-toggle-label]');
        if (label) {
            label.textContent = willShow ? 'Ẩn biểu đồ chi tiết' : 'Hiện biểu đồ chi tiết';
        }

        if (willShow) {
            initializeTotalRevenueDetailCharts();
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }
</script>
