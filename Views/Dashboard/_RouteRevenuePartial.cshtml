@model Bus_ticket.ViewModels.RouteRevenueReportViewModel

@{
    var fromDateValue = ViewBag.FromDateValue is DateTime fromDt ? fromDt.ToString("yyyy-MM-dd") : ViewBag.FromDateValue as string ?? Model.FromDate.ToString("yyyy-MM-dd");
    var toDateValue = ViewBag.ToDateValue is DateTime toDt ? toDt.ToString("yyyy-MM-dd") : ViewBag.ToDateValue as string ?? Model.ToDate.ToString("yyyy-MM-dd");
    var items = Model.Items.OrderByDescending(x => x.TotalRevenue).ToList();
    var palette = new[] { "#8b5cf6", "#10b981", "#0ea5e9", "#f59e0b", "#ef4444", "#6b7280" };
    var labels = items.Select(x => x.RouteName).ToList();
    var values = items.Select(x => x.TotalRevenue).ToList();
    var colors = labels.Select((_, i) => palette[i % palette.Length]).ToList();
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Doanh thu theo tuyến đường</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Phân bổ doanh thu theo từng tuyến, sắp xếp giảm dần</p>
    </div>
    <div class="flex items-center gap-3">
        <input type="text" id="date_range_RouteRevenue" readonly
               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2.5 cursor-pointer shadow-sm"
               placeholder="Chọn khoảng ngày...">
        <button type="button" onclick="exportRouteRevenueExcel()"
                class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-lg text-sm px-4 py-2.5 shadow-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Xuất Excel
        </button>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Tổng doanh thu</p>
        <h4 class="text-xl font-bold text-emerald-600 dark:text-emerald-400">@Model.GrandTotalRevenue.ToString("N0") đ</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Booking thành công</p>
        <h4 class="text-xl font-bold text-blue-600 dark:text-blue-400">@Model.GrandTotalBookings.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Số vé bán</p>
        <h4 class="text-xl font-bold text-purple-600 dark:text-purple-400">@Model.GrandTotalTickets.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Số tuyến có doanh thu</p>
        <h4 class="text-xl font-bold text-amber-600 dark:text-amber-400">@items.Count.ToString("N0")</h4>
    </div>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm mb-6">
    <div class="flex justify-between items-center mb-4">
        <div>
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Tỷ trọng doanh thu theo tuyến</h3>
            <p class="text-xs text-gray-500 mt-1">Click biểu đồ để xem chi tiết theo tuyến</p>
        </div>
        <a asp-controller="Dashboard" asp-action="RouteRevenueDetail"
           asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue"
           class="text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1">
            Mở trang chi tiết
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
    </div>
    @if (!items.Any() || Model.GrandTotalRevenue <= 0)
    {
        <div class="py-16 text-center text-gray-500">Không có dữ liệu doanh thu trong khoảng thời gian này.</div>
    }
    else
    {
        <div class="relative h-[320px] w-full flex justify-center">
            <canvas id="routeRevenuePieChart"></canvas>
        </div>
    }
</div>

<script>
    initializeDashboardDateRangePicker('RouteRevenue', '@fromDateValue', '@toDateValue');
    renderDashboardPieChart('routeRevenuePieChart', @Html.Raw(Json.Serialize(labels)), @Html.Raw(Json.Serialize(values)), @Html.Raw(Json.Serialize(colors)), 'Doanh thu', function (index, chartLabels) {
        const routeName = chartLabels[index];
        if (!routeName) return null;
        return buildDashboardDetailUrl('RouteRevenueDetail', currentFromDate || '@fromDateValue', currentToDate || '@toDateValue', 'routeName', routeName);
    });

    function exportRouteRevenueExcel() {
        var start = currentFromDate || '@fromDateValue';
        var end = currentToDate || '@toDateValue';
        window.location.href = `/Dashboard/ExportRouteRevenue?fromDate=${start}&endDate=${end}`;
    }
</script>
