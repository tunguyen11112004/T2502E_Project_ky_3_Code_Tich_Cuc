@model Bus_ticket.ViewModels.LowOccupancyTripsViewModel

@{
    var fromDateValue = ViewBag.FromDateValue is DateTime fromDt ? fromDt.ToString("yyyy-MM-dd") : ViewBag.FromDateValue as string ?? Model.FromDate.ToString("yyyy-MM-dd");
    var toDateValue = ViewBag.ToDateValue is DateTime toDt ? toDt.ToString("yyyy-MM-dd") : ViewBag.ToDateValue as string ?? Model.ToDate.ToString("yyyy-MM-dd");

    var lowItems = Model.LowOccupancyTrips
        .OrderBy(x => x.OccupancyRate)
        .ThenByDescending(x => x.EmptySeats)
        .ThenBy(x => x.DepartureTime)
        .ToList();

    var palette = new[] { "#8b5cf6", "#10b981", "#0ea5e9", "#f59e0b", "#ef4444", "#6b7280" };
    var chartItems = lowItems.Take(10).ToList();
    var labels = chartItems.Select(x => x.TripCode).ToList();
    var values = chartItems.Select(x => x.EmptySeats).ToList();
    var colors = labels.Select((_, i) => palette[i % palette.Length]).ToList();
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Thống kê chuyến xe ít khách</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Chuyến có tỷ lệ lấp đầy dưới @Model.OccupancyThreshold.ToString("N0")%</p>
    </div>
    <div class="flex items-center gap-3">
        <input type="text" id="date_range_LowOccupancyTrips" readonly
               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2.5 cursor-pointer shadow-sm"
               placeholder="Chọn khoảng ngày...">
        <button type="button" onclick="exportLowOccupancyTripsExcel()"
                class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-lg text-sm px-4 py-2.5 shadow-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Xuất Excel
        </button>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Tổng chuyến kiểm tra</p>
        <h4 class="text-xl font-bold text-gray-900 dark:text-white">@Model.TotalTripsChecked.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Chuyến ít khách</p>
        <h4 class="text-xl font-bold text-orange-600 dark:text-orange-400">@Model.LowOccupancyTripCount.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Ghế trống (chuyến ít khách)</p>
        <h4 class="text-xl font-bold text-amber-600 dark:text-amber-400">@Model.TotalEmptySeats.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Tỷ lệ lấp đầy TB</p>
        <h4 class="text-xl font-bold text-cyan-600 dark:text-cyan-400">@Model.AverageOccupancyRate.ToString("N2")%</h4>
    </div>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm mb-6">
    <div class="flex justify-between items-center mb-4">
        <div>
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Top chuyến ít khách nhất</h3>
            <p class="text-xs text-gray-500 mt-1">Click biểu đồ để xem chi tiết theo chuyến</p>
        </div>
        <a asp-controller="Dashboard" asp-action="LowOccupancyTripsDetail"
           asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue"
           class="text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1">
            Mở trang chi tiết
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
    </div>
    @if (!chartItems.Any() || chartItems.Sum(x => x.EmptySeats) <= 0)
    {
        <div class="py-16 text-center text-gray-500">Không có chuyến ít khách trong khoảng thời gian này.</div>
    }
    else
    {
        <div class="relative h-[320px] w-full flex justify-center">
            <canvas id="lowOccupancyPieChart"></canvas>
        </div>
    }
</div>

<script>
    initializeDashboardDateRangePicker('LowOccupancyTrips', '@fromDateValue', '@toDateValue');
    renderDashboardPieChart('lowOccupancyPieChart', @Html.Raw(Json.Serialize(labels)), @Html.Raw(Json.Serialize(values)), @Html.Raw(Json.Serialize(colors)), 'Ghế trống', function (index, chartLabels) {
        const tripCode = chartLabels[index];
        if (!tripCode) return null;
        return buildDashboardDetailUrl('LowOccupancyTripsDetail', currentFromDate || '@fromDateValue', currentToDate || '@toDateValue', 'tripCode', tripCode);
    });

    function exportLowOccupancyTripsExcel() {
        var start = currentFromDate || '@fromDateValue';
        var end = currentToDate || '@toDateValue';
        window.location.href = `/Dashboard/ExportLowOccupancyTrips?fromDate=${start}&toDate=${end}&occupancyThreshold=@Model.OccupancyThreshold`;
    }
</script>
