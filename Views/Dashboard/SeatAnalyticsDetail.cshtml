@model IEnumerable<Bus_ticket.ViewModels.SeatAnalyticsViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết Tỷ lệ lấp đầy ghế";
    ViewData["ReportTitle"] = "Chi tiết Tỷ lệ lấp đầy ghế";
    ViewData["ReportSubtitle"] = "Danh sách đầy đủ chuyến xe và tỷ lệ lấp đầy ghế";
    ViewData["PickerType"] = "SeatAnalyticsDetail";
    ViewData["StatType"] = "SeatAnalytics";
    ViewData["ExportHandler"] = "exportSeatAnalyticsDetailExcel";
    ViewData["ShowChartToggle"] = true;
    ViewData["ChartSectionId"] = "seatAnalyticsDetailCharts";
    ViewData["ChartInitFunction"] = "initializeSeatAnalyticsDetailCharts";
    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/admin-assets/js/pie-chart-percent-labels.js?v=6"></script>
<script src="/admin-assets/js/dashboard-date-range.js?v=1"></script>
<script src="/admin-assets/js/dashboard-detail-charts.js?v=4"></script>

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full overflow-x-hidden">
    @await Html.PartialAsync("_ReportDetailHeader")
    @await Html.PartialAsync("_SeatAnalyticsDetailChartsPartial", Model)
    @await Html.PartialAsync("_SeatAnalyticsDetailTablesPartial", Model)
</div>

@await Html.PartialAsync("_ReportDetailDateScript")

<script>
    const seatAnalyticsRouteName = @Html.Raw(Json.Serialize(ViewBag.RouteNameFilter as string ?? string.Empty));
    const seatAnalyticsLicensePlate = @Html.Raw(Json.Serialize(ViewBag.LicensePlateFilter as string ?? string.Empty));

    function buildSeatAnalyticsDetailUrl(options) {
        options = options || {};
        const params = new URLSearchParams();
        params.set('fromDate', detailFromDate);
        params.set('toDate', detailToDate);

        const tripCode = detailFilterParam === 'tripCode' ? detailFilterValue : '';
        const routeName = options.routeName !== undefined
            ? options.routeName
            : (document.getElementById('seatAnalyticsRouteFilter')?.value || '').trim();
        const licensePlate = options.licensePlate !== undefined
            ? options.licensePlate
            : (document.getElementById('seatAnalyticsLicensePlateFilter')?.value || '').trim();

        if (tripCode) params.set('tripCode', tripCode);
        if (routeName) params.set('routeName', routeName);
        if (licensePlate) params.set('licensePlate', licensePlate);

        return `/Dashboard/SeatAnalyticsDetail?${params.toString()}`;
    }

    window.applySeatAnalyticsTableFilters = function () {
        window.location.href = buildSeatAnalyticsDetailUrl();
    };

    window.clearSeatAnalyticsTableFilters = function () {
        window.location.href = buildSeatAnalyticsDetailUrl({ routeName: '', licensePlate: '' });
    };

    window.dashboardDateRangeApplyHandlers[detailPickerType] = function (start, end) {
        const params = new URLSearchParams();
        params.set('fromDate', start);
        params.set('toDate', end);

        if (detailFilterParam === 'tripCode' && detailFilterValue) {
            params.set('tripCode', detailFilterValue);
        }
        if (seatAnalyticsRouteName) params.set('routeName', seatAnalyticsRouteName);
        if (seatAnalyticsLicensePlate) params.set('licensePlate', seatAnalyticsLicensePlate);

        window.location.href = `/Dashboard/SeatAnalyticsDetail?${params.toString()}`;
    };

    document.addEventListener('DOMContentLoaded', function () {
        const input = document.getElementById('seatAnalyticsLicensePlateFilter');
        if (input) {
            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applySeatAnalyticsTableFilters();
                }
            });
        }
    });

    function exportSeatAnalyticsDetailExcel() {
        const range = getDashboardDateRangeValues('SeatAnalyticsDetail', detailFromDate, detailToDate);
        window.location.href = `/Dashboard/ExportSeatAnalytics?fromDate=${range.start}&endDate=${range.end}`;
    }
</script>
