@model IEnumerable<Bus_ticket.ViewModels.BranchCancellationViewModel>
@{
    var items = Model?.ToList() ?? new List<Bus_ticket.ViewModels.BranchCancellationViewModel>();
    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
    var palette = new[] { "#8b5cf6", "#10b981", "#0ea5e9", "#f59e0b", "#ef4444", "#6b7280" };
    var labels = items.Select(x => x.BranchName).ToList();
    var values = items.Select(x => x.CanceledTrips).ToList();
    var colors = labels.Select((_, i) => palette[i % palette.Length]).ToList();
}

<div id="branchCancellationDetailCharts" class="hidden space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-1">Phân bổ chuyến hủy theo nhà xe</h3>
        <p class="text-xs text-gray-500 mb-4">Click biểu đồ để lọc theo nhà xe</p>
        @if (!items.Any() || values.Sum() <= 0)
        {
            <div class="py-16 text-center text-gray-500">Không có dữ liệu biểu đồ.</div>
        }
        else
        {
            <div class="relative h-[320px] w-full flex justify-center">
                <canvas id="detailBranchCancellationPieChart"></canvas>
            </div>
        }
    </div>
</div>

<script>
    window.branchCancellationDetailChartsInitialized = false;
    function initializeBranchCancellationDetailCharts() {
        if (window.branchCancellationDetailChartsInitialized) return;
        const detailFromDate = @Html.Raw(Json.Serialize(fromDateValue));
        const detailToDate = @Html.Raw(Json.Serialize(toDateValue));
        renderDetailPieChart(
            'detailBranchCancellationPieChart',
            @Html.Raw(Json.Serialize(labels)),
            @Html.Raw(Json.Serialize(values)),
            @Html.Raw(Json.Serialize(colors)),
            'Chuyến hủy',
            {
                valueSuffix: ' chuyến',
                onSliceClick: function (index, chartLabels) {
                    const branchName = chartLabels[index];
                    if (!branchName) return null;
                    return buildDashboardDetailUrl('BranchCancellationDetail', detailFromDate, detailToDate, 'branchName', branchName);
                }
            }
        );
        window.branchCancellationDetailChartsInitialized = true;
    }
</script>
