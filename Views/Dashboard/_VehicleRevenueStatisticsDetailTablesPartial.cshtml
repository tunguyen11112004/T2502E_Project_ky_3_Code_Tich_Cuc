@model Bus_ticket.ViewModels.VehicleRevenueStatisticsViewModel

@{
    var typeItems = Model.BusTypeRevenueItems
        .OrderByDescending(x => x.TotalRevenue)
        .ThenByDescending(x => x.TotalTickets)
        .ThenBy(x => x.BusType)
        .ToList();

    var busItems = Model.BusRevenueItems
        .OrderByDescending(x => x.TotalRevenue)
        .ThenByDescending(x => x.TotalTickets)
        .ThenBy(x => x.BusCode)
        .ToList();

    var busClassFilterOptions = ViewBag.BusClassFilterOptions as List<string> ?? new List<string>();
    var busCodeFilter = ViewBag.BusCodeFilter as string ?? string.Empty;
    var licensePlateFilter = ViewBag.LicensePlateFilter as string ?? string.Empty;
    var busClassNameFilter = ViewBag.BusClassNameFilter as string ?? string.Empty;
    var hasBusTableFilters = !string.IsNullOrWhiteSpace(busCodeFilter)
        || !string.IsNullOrWhiteSpace(licensePlateFilter)
        || !string.IsNullOrWhiteSpace(busClassNameFilter);
}

<div class="space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Doanh thu theo loại xe</h3>
            <p class="text-xs text-gray-500 mt-1">Dữ liệu gom từ bookings, trips, buses và busclasses</p>
        </div>
        <div class="overflow-x-auto max-h-[520px]">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10">
                <tr>
                    <th class="px-6 py-4">STT</th>
                    <th class="px-6 py-4">Loại xe</th>
                    <th class="px-6 py-4">Hạng xe</th>
                    <th class="px-6 py-4 text-center">Booking</th>
                    <th class="px-6 py-4 text-center">Vé</th>
                    <th class="px-6 py-4 text-right">Doanh thu</th>
                    <th class="px-6 py-4 text-right">Tỷ lệ</th>
                </tr>
                </thead>
                <tbody>
                @if (!typeItems.Any())
                {
                    <tr><td colspan="7" class="px-6 py-10 text-center text-gray-500">Không có dữ liệu hiển thị.</td></tr>
                }
                else
                {
                    for (var i = 0; i < typeItems.Count; i++)
                    {
                        var item = typeItems[i];
                        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 font-bold text-amber-500">#@(i + 1)</td>
                            <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">@item.BusType</td>
                            <td class="px-6 py-4">@item.BusClassName</td>
                            <td class="px-6 py-4 text-center">@item.TotalBookings.ToString("N0")</td>
                            <td class="px-6 py-4 text-center">@item.TotalTickets.ToString("N0")</td>
                            <td class="px-6 py-4 text-right font-bold text-emerald-600 dark:text-emerald-400">@item.TotalRevenue.ToString("N0") đ</td>
                            <td class="px-6 py-4 text-right font-semibold">@item.Percentage.ToString("N2")%</td>
                        </tr>
                    }
                }
                </tbody>
                <tfoot class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700">
                <tr>
                    <td colspan="3" class="px-6 py-4 font-bold text-gray-900 dark:text-white">Tổng cộng</td>
                    <td class="px-6 py-4 text-center font-bold text-gray-900 dark:text-white">@Model.GrandTotalBookings.ToString("N0")</td>
                    <td class="px-6 py-4 text-center font-bold text-gray-900 dark:text-white">@Model.GrandTotalTickets.ToString("N0")</td>
                    <td class="px-6 py-4 text-right font-bold text-emerald-600 dark:text-emerald-400">@Model.GrandTotalRevenue.ToString("N0") đ</td>
                    <td class="px-6 py-4 text-right font-bold text-gray-900 dark:text-white">@(Model.GrandTotalRevenue > 0 ? "100.00%" : "0.00%")</td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-4">
                <div>
                    <h3 class="text-md font-semibold text-gray-900 dark:text-white">Xếp hạng doanh thu từng xe</h3>
                    <p class="text-xs text-gray-500 mt-1">Sắp xếp theo doanh thu giảm dần</p>
                </div>
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label for="vehicleBusCodeFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Mã xe / Biển số</label>
                        <input type="text"
                               id="vehicleBusCodeFilter"
                               value="@busCodeFilter"
                               placeholder="Mã xe hoặc biển số..."
                               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[160px] p-2 shadow-sm" />
                    </div>
                    <div>
                        <label for="vehicleLicensePlateFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Biển số</label>
                        <input type="text"
                               id="vehicleLicensePlateFilter"
                               value="@licensePlateFilter"
                               placeholder="Tìm biển số..."
                               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[160px] p-2 shadow-sm" />
                    </div>
                    <div>
                        <label for="vehicleBusClassFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Hạng xe</label>
                        <select id="vehicleBusClassFilter"
                                class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[220px] p-2 shadow-sm">
                            <option value="">Tất cả hạng xe</option>
                            @foreach (var busClassOption in busClassFilterOptions)
                            {
                                if (string.Equals(busClassOption, busClassNameFilter, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@busClassOption" selected="selected">@busClassOption</option>
                                }
                                else
                                {
                                    <option value="@busClassOption">@busClassOption</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="button"
                            onclick="applyVehicleRevenueBusFilters()"
                            class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
                        Tìm kiếm
                    </button>
                    @if (hasBusTableFilters)
                    {
                        <button type="button"
                                onclick="clearVehicleRevenueBusFilters()"
                                class="px-3 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
                            Xóa lọc bảng
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="overflow-x-auto max-h-[520px]">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10">
                <tr>
                    <th class="px-6 py-4">STT</th>
                    <th class="px-6 py-4">Mã xe</th>
                    <th class="px-6 py-4">Biển số</th>
                    <th class="px-6 py-4">Hạng xe</th>
                    <th class="px-6 py-4 text-center">Booking</th>
                    <th class="px-6 py-4 text-center">Vé</th>
                    <th class="px-6 py-4 text-right">Doanh thu</th>
                    <th class="px-6 py-4 text-right">Tỷ lệ</th>
                </tr>
                </thead>
                <tbody>
                @if (!busItems.Any())
                {
                    <tr><td colspan="8" class="px-6 py-10 text-center text-gray-500">Không có dữ liệu doanh thu theo xe.</td></tr>
                }
                else
                {
                    for (var i = 0; i < busItems.Count; i++)
                    {
                        var item = busItems[i];
                        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 font-bold text-amber-500">#@(i + 1)</td>
                            <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">@item.BusCode</td>
                            <td class="px-6 py-4">@item.LicensePlate</td>
                            <td class="px-6 py-4">@item.BusClassName</td>
                            <td class="px-6 py-4 text-center">@item.TotalBookings.ToString("N0")</td>
                            <td class="px-6 py-4 text-center">@item.TotalTickets.ToString("N0")</td>
                            <td class="px-6 py-4 text-right font-bold text-emerald-600 dark:text-emerald-400">@item.TotalRevenue.ToString("N0") đ</td>
                            <td class="px-6 py-4 text-right font-semibold">@item.Percentage.ToString("N2")%</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
