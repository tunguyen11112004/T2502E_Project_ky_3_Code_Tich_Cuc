@model Bus_ticket.ViewModels.TicketStatusStatisticsViewModel

@{
    var fromDateValue = ViewBag.FromDateValue is DateTime fromDt
        ? fromDt.ToString("yyyy-MM-dd")
        : ViewBag.FromDateValue as string ?? Model.FromDate.ToString("yyyy-MM-dd");
    var toDateValue = ViewBag.ToDateValue is DateTime toDt
        ? toDt.ToString("yyyy-MM-dd")
        : ViewBag.ToDateValue as string ?? Model.ToDate.ToString("yyyy-MM-dd");

    var items = Model.Items
        .OrderByDescending(x => x.TicketCount)
        .ThenByDescending(x => x.BookingCount)
        .ThenBy(x => x.StatusLabel)
        .ToList();

    var palette = new[] { "#10b981", "#ef4444", "#8b5cf6", "#0ea5e9", "#f59e0b", "#6b7280" };
    var labels = items.Select(x => x.StatusLabel).ToList();
    var statusKeys = items.Select(x => x.StatusKey).ToList();
    var values = items.Select(x => x.TicketCount).ToList();
    var colors = items.Select((x, i) => x.StatusKey == "successful" ? "#10b981" : x.StatusKey == "cancelled" ? "#ef4444" : palette[i % palette.Length]).ToList();
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Thống kê vé thành công và vé hủy</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">So sánh số lượng vé đặt thành công và vé đã hủy</p>
    </div>
    <div class="flex items-center gap-3">
        <input type="text" id="date_range_TicketStatusStatistics" readonly
               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2.5 cursor-pointer shadow-sm"
               placeholder="Chọn khoảng ngày...">
        <button type="button" onclick="exportTicketStatusStatisticsExcel()"
                class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-lg text-sm px-4 py-2.5 shadow-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Xuất Excel
        </button>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Vé thành công</p>
        <h4 class="text-xl font-bold text-emerald-600 dark:text-emerald-400">@Model.SuccessfulTickets.ToString("N0")</h4>
        <p class="text-xs text-gray-500 mt-1">@Model.SuccessfulBookings.ToString("N0") booking</p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Vé hủy</p>
        <h4 class="text-xl font-bold text-red-600 dark:text-red-400">@Model.CancelledTickets.ToString("N0")</h4>
        <p class="text-xs text-gray-500 mt-1">@Model.CancelledBookings.ToString("N0") booking</p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Tổng vé</p>
        <h4 class="text-xl font-bold text-blue-600 dark:text-blue-400">@Model.TotalTickets.ToString("N0")</h4>
        <p class="text-xs text-gray-500 mt-1">Vé thành công + vé hủy</p>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Tỷ lệ hủy</p>
        <h4 class="text-xl font-bold text-amber-600 dark:text-amber-400">@Model.CancelledPercentage.ToString("N2")%</h4>
        <p class="text-xs text-gray-500 mt-1">Dựa trên số lượng vé</p>
    </div>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm mb-6">
    <div class="flex justify-between items-center mb-4">
        <div>
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Tỷ trọng vé theo trạng thái</h3>
            <p class="text-xs text-gray-500 mt-1">Click biểu đồ để xem chi tiết theo trạng thái</p>
        </div>
        <a asp-controller="Dashboard" asp-action="TicketStatusStatisticsDetail"
           asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue"
           class="text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1">
            Mở trang chi tiết
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
    </div>
    @if (!items.Any() || Model.TotalTickets <= 0)
    {
        <div class="py-16 text-center text-gray-500">Không có dữ liệu vé trong khoảng thời gian này.</div>
    }
    else
    {
        <div class="relative h-[320px] w-full flex justify-center">
            <canvas id="ticketStatusPieChart"></canvas>
        </div>
    }
</div>

<script>
    initializeDashboardDateRangePicker('TicketStatusStatistics', '@fromDateValue', '@toDateValue');
    renderDashboardPieChart('ticketStatusPieChart', @Html.Raw(Json.Serialize(labels)), @Html.Raw(Json.Serialize(values)), @Html.Raw(Json.Serialize(colors)), 'Số vé', function (index) {
        const statusKeys = @Html.Raw(Json.Serialize(statusKeys));
        const statusKey = statusKeys[index];
        if (!statusKey) return null;
        return buildDashboardDetailUrl('TicketStatusStatisticsDetail', currentFromDate || '@fromDateValue', currentToDate || '@toDateValue', 'statusKey', statusKey);
    });

    function exportTicketStatusStatisticsExcel() {
        var start = currentFromDate || '@fromDateValue';
        var end = currentToDate || '@toDateValue';
        window.location.href = `/Dashboard/ExportTicketStatusStatistics?fromDate=${start}&toDate=${end}`;
    }
</script>
