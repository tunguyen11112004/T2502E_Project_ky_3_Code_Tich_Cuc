@model IEnumerable<Bus_ticket.ViewModels.OperatorRevenueViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết Doanh thu nhà xe";
    ViewData["ReportTitle"] = "Chi tiết Doanh thu nhà xe";
    ViewData["ReportSubtitle"] = "Bảng xếp hạng nhà xe theo doanh thu booking đã thanh toán";
    ViewData["PickerType"] = "OperatorRevenueDetail";
    ViewData["StatType"] = "OperatorRevenue";
    ViewData["ExportHandler"] = "exportOperatorRevenueDetailExcel";
    ViewData["ShowChartToggle"] = true;
    ViewData["ChartSectionId"] = "operatorRevenueDetailCharts";
    ViewData["ChartInitFunction"] = "initializeOperatorRevenueDetailCharts";
    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/admin-assets/js/dashboard-date-range.js?v=1"></script>
<script src="/admin-assets/js/dashboard-detail-charts.js?v=2"></script>

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full overflow-x-hidden">
    @await Html.PartialAsync("_ReportDetailHeader")
    @await Html.PartialAsync("_OperatorRevenueDetailChartsPartial", Model)
    @await Html.PartialAsync("_OperatorRevenueDetailTablesPartial", Model)
</div>

@await Html.PartialAsync("_ReportDetailDateScript")

<script>
    function exportOperatorRevenueDetailExcel() {
        const range = getDashboardDateRangeValues('OperatorRevenueDetail', '@fromDateValue', '@toDateValue');
        window.location.href = `/Dashboard/ExportOperatorRevenue?fromDate=${range.start}&endDate=${range.end}`;
    }
</script>
