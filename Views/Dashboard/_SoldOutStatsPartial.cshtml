@model List<Bus_ticket.ViewModels.SeatAnalyticsViewModel>

@{
    var items = Model ?? new List<Bus_ticket.ViewModels.SeatAnalyticsViewModel>();
    var fromDateValue = ViewBag.FromDateValue as string ?? DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd");
    var toDateValue = ViewBag.ToDateValue as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    var tripCount = items.Count;
    var totalSeats = items.Sum(x => x.TotalSeats);
    var totalBookedSeats = items.Sum(x => x.BookedSeats);
    var uniqueRoutes = items.Select(x => x.RouteName).Distinct().Count();
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Danh sách chuyến xe cháy ghế</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Các chuyến xe đã bán hết 100% vé</p>
    </div>
    <div class="flex items-center gap-3">
        <input type="text" id="date_range_SoldOutStats" readonly
               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2.5 cursor-pointer shadow-sm"
               placeholder="Chọn khoảng ngày...">
        <button type="button" onclick="exportSoldOutStatsExcel()"
                class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-lg text-sm px-4 py-2.5 shadow-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Xuất Excel
        </button>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Số chuyến cháy ghế</p>
        <h4 class="text-xl font-bold text-rose-600 dark:text-rose-400">@tripCount.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Tổng ghế</p>
        <h4 class="text-xl font-bold text-blue-600 dark:text-blue-400">@totalSeats.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Ghế đã đặt</p>
        <h4 class="text-xl font-bold text-emerald-600 dark:text-emerald-400">@totalBookedSeats.ToString("N0")</h4>
    </div>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <p class="text-sm text-gray-500 mb-1">Số tuyến có cháy ghế</p>
        <h4 class="text-xl font-bold text-purple-600 dark:text-purple-400">@uniqueRoutes.ToString("N0")</h4>
    </div>
</div>

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Danh sách chi tiết</h3>
            <p class="text-xs text-gray-500 mt-1">Xem đầy đủ thông tin từng chuyến cháy ghế</p>
        </div>
        <a asp-controller="Dashboard" asp-action="SoldOutStatsDetail"
           asp-route-fromDate="@fromDateValue" asp-route-toDate="@toDateValue"
           class="text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1">
            Mở trang chi tiết
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
    </div>
</div>

<script>
    initializeDashboardDateRangePicker('SoldOutStats', '@fromDateValue', '@toDateValue');

    function exportSoldOutStatsExcel() {
        var start = currentFromDate || '@fromDateValue';
        var end = currentToDate || '@toDateValue';
        window.location.href = `/Dashboard/ExportSoldOutStats?startDate=${start}&endDate=${end}`;
    }
</script>
