@model IEnumerable<Bus_ticket.ViewModels.BranchCancellationViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết tỷ lệ hủy chuyến";
    ViewData["ReportTitle"] = "Chi tiết tỷ lệ hủy chuyến theo nhà xe";
    ViewData["ReportSubtitle"] = "Bảng xếp hạng nhà xe theo tỷ lệ chuyến bị hủy";
    ViewData["PickerType"] = "BranchCancellationDetail";
    ViewData["StatType"] = "BranchCancellation";
    ViewData["ExportHandler"] = "exportBranchCancellationDetailExcel";
    ViewData["ShowChartToggle"] = true;
    ViewData["ChartSectionId"] = "branchCancellationDetailCharts";
    ViewData["ChartInitFunction"] = "initializeBranchCancellationDetailCharts";
    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/admin-assets/js/dashboard-date-range.js?v=1"></script>
<script src="/admin-assets/js/dashboard-detail-charts.js?v=2"></script>

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full overflow-x-hidden">
    @await Html.PartialAsync("_ReportDetailHeader")
    @await Html.PartialAsync("_BranchCancellationDetailChartsPartial", Model)
    @await Html.PartialAsync("_BranchCancellationDetailTablesPartial", Model)
</div>

@await Html.PartialAsync("_ReportDetailDateScript")

<script>
    function exportBranchCancellationDetailExcel() {
        const range = getDashboardDateRangeValues('BranchCancellationDetail', '@fromDateValue', '@toDateValue');
        window.location.href = `/Dashboard/ExportBranchCancellation?fromDate=${range.start}&toDate=${range.end}`;
    }
</script>
