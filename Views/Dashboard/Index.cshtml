@using Bus_ticket.Services
@inject SidebarPermissionService SidebarPermissionService

@{
Layout = "_AdminLayout";
ViewData["Title"] = "Admin Dashboard";

var permissionNames = await SidebarPermissionService.GetCurrentUserPermissionNamesAsync(User);
var isAdmin = User.IsInRole("Admin");

var canViewOperatorRevenue = isAdmin || SidebarPermissionService.HasPermission(
permissionNames, "OperatorRevenue", "Operator Revenue", "DoanhThuNhaXe", "/Dashboard/OperatorRevenuePartial"
);

var canViewBranchCancellation = isAdmin || SidebarPermissionService.HasPermission(
permissionNames, "BranchCancellation", "Cancellation", "Cancel", "HuyChuyen", "/Dashboard/BranchCancellationPartial"
);

var canViewSeatAnalytics = isAdmin || SidebarPermissionService.HasPermission(
permissionNames, "SeatAnalytics", "Seat Analytics", "Occupancy", "LapDay", "/Dashboard/SeatAnalyticsPartial"
);

var canViewRouteRevenue = isAdmin || SidebarPermissionService.HasPermission(
permissionNames, "Dashboard", "Report", "Revenue", "Route", "RouteRevenue", "RouteRevenuePartial", "/Dashboard/RouteRevenue", "/Dashboard/RouteRevenuePartial"
);

var canViewTotalRevenue = isAdmin;
var canViewSoldOutStats = isAdmin;
var canViewLowOccupancy = isAdmin;
var canViewTicketStatus = isAdmin;
var canViewVehicleRevenue = isAdmin;
}

<div class="p-6 space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-950 dark:text-white mb-1">Báo cáo Dashboard</h1>
        <p class="text-sm text-gray-600 dark:text-gray-400">
            Chọn chủ đề và loại báo cáo để xem thống kê tương tác trực tiếp.
        </p>
    </div>

    @{
        var hasFinancial = canViewTotalRevenue || canViewOperatorRevenue || canViewRouteRevenue || canViewVehicleRevenue;
        var hasOperations = canViewSeatAnalytics || canViewLowOccupancy || canViewSoldOutStats;
        var hasCancellations = canViewBranchCancellation || canViewTicketStatus;
        var defaultMainTab = canViewTotalRevenue || canViewOperatorRevenue || canViewRouteRevenue || canViewVehicleRevenue
            ? "financial"
            : hasOperations ? "operations" : "cancellations";
        var defaultStatType = canViewTotalRevenue ? "TotalRevenue"
            : canViewOperatorRevenue ? "OperatorRevenue"
            : canViewRouteRevenue ? "RouteRevenue"
            : canViewVehicleRevenue ? "VehicleRevenueStatistics"
            : canViewSeatAnalytics ? "SeatAnalytics"
            : canViewLowOccupancy ? "LowOccupancyTrips"
            : canViewSoldOutStats ? "SoldOutStats"
            : canViewBranchCancellation ? "BranchCancellation"
            : "TicketStatusStatistics";
    }

    <!-- THANH TAB CHỦ ĐỀ LỚN -->
    @if (hasFinancial || hasOperations || hasCancellations)
    {
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
            <div class="border-b border-gray-200 dark:border-gray-700 px-4 sm:px-6">
                <nav class="flex flex-wrap gap-1 -mb-px" aria-label="Chủ đề báo cáo">
                    @if (hasFinancial)
                    {
                        <button type="button"
                                data-main-tab="financial"
                                onclick="switchDashboardMainTab('financial')"
                                class="px-4 py-3 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap">
                            Tổng quan / Doanh thu
                        </button>
                    }
                    @if (hasOperations)
                    {
                        <button type="button"
                                data-main-tab="operations"
                                onclick="switchDashboardMainTab('operations')"
                                class="px-4 py-3 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap">
                            Hiệu suất vận hành
                        </button>
                    }
                    @if (hasCancellations)
                    {
                        <button type="button"
                                data-main-tab="cancellations"
                                onclick="switchDashboardMainTab('cancellations')"
                                class="px-4 py-3 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap">
                            Tỷ lệ hủy vé & chuyến
                        </button>
                    }
                </nav>
            </div>

            <!-- THẺ CON (FILTER NHỎ) -->
            <div class="px-4 sm:px-6 py-4 bg-gray-50/60 dark:bg-gray-900/30">
                @if (hasFinancial)
                {
                    <div data-sub-tabs="financial" class="flex flex-wrap gap-2 @(defaultMainTab == "financial" ? "" : "hidden")">
                        @if (canViewTotalRevenue)
                        {
                            <button type="button" onclick="loadStatistic('TotalRevenue')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="TotalRevenue">
                                Tổng doanh thu
                            </button>
                        }
                        @if (canViewOperatorRevenue)
                        {
                            <button type="button" onclick="loadStatistic('OperatorRevenue')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="OperatorRevenue">
                                Doanh thu nhà xe
                            </button>
                        }
                        @if (canViewRouteRevenue)
                        {
                            <button type="button" onclick="loadStatistic('RouteRevenue')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="RouteRevenue">
                                Doanh thu tuyến đường
                            </button>
                        }
                        @if (canViewVehicleRevenue)
                        {
                            <button type="button" onclick="loadStatistic('VehicleRevenueStatistics')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="VehicleRevenueStatistics">
                                Doanh thu phương tiện
                            </button>
                        }
                    </div>
                }
                @if (hasOperations)
                {
                    <div data-sub-tabs="operations" class="flex flex-wrap gap-2 @(defaultMainTab == "operations" ? "" : "hidden")">
                        @if (canViewSeatAnalytics)
                        {
                            <button type="button" onclick="loadStatistic('SeatAnalytics')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="SeatAnalytics">
                                Hiệu suất lấp đầy
                            </button>
                        }
                        @if (canViewLowOccupancy)
                        {
                            <button type="button" onclick="loadStatistic('LowOccupancyTrips')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="LowOccupancyTrips">
                                Chuyến ít khách
                            </button>
                        }
                        @if (canViewSoldOutStats)
                        {
                            <button type="button" onclick="loadStatistic('SoldOutStats')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="SoldOutStats">
                                Chuyến cháy ghế
                            </button>
                        }
                    </div>
                }
                @if (hasCancellations)
                {
                    <div data-sub-tabs="cancellations" class="flex flex-wrap gap-2 @(defaultMainTab == "cancellations" ? "" : "hidden")">
                        @if (canViewBranchCancellation)
                        {
                            <button type="button" onclick="loadStatistic('BranchCancellation')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="BranchCancellation">
                                Tỷ lệ hủy chuyến
                            </button>
                        }
                        @if (canViewTicketStatus)
                        {
                            <button type="button" onclick="loadStatistic('TicketStatusStatistics')"
                                    class="dashboard-sub-tab px-3 py-1.5 text-xs sm:text-sm font-medium rounded-lg border transition-all"
                                    data-stat-type="TicketStatusStatistics">
                                Tỷ lệ vé hủy
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- KHU VỰC HIỂN THỊ DỮ LIỆU ĐỘNG -->
    <div id="statisticContainer" class="bg-gray-50 dark:bg-gray-900/40 rounded-xl min-h-[250px] p-4 relative border border-dashed border-gray-300 dark:border-gray-700">
        <div id="placeholderText" class="text-center py-16 text-gray-400">
            <p>Chọn loại báo cáo ở thanh tab phía trên để hiển thị dữ liệu.</p>
        </div>

        <div id="loadingSpinner" class="hidden absolute inset-0 bg-white/50 dark:bg-gray-900/60 flex items-center justify-center rounded-xl z-10">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-500"></div>
        </div>

        <div id="dynamicContent"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/admin-assets/js/pie-chart-percent-labels.js?v=6"></script>

<style>
    .dashboard-range-popup {
        width: min(720px, calc(100vw - 32px));
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    }
</style>

<script src="/admin-assets/js/dashboard-date-range.js"></script>
<script src="/admin-assets/js/dashboard-tabs.js?v=1"></script>
<script src="/admin-assets/js/revenue-chart-table-filters.js?v=3"></script>
<script>
    let currentType = '';
    let currentFromDate = '';
    let currentToDate = '';
    window.dashboardCharts = window.dashboardCharts || {};

    const statTypeToMainTab = {
        TotalRevenue: 'financial',
        OperatorRevenue: 'financial',
        RouteRevenue: 'financial',
        VehicleRevenueStatistics: 'financial',
        SeatAnalytics: 'operations',
        LowOccupancyTrips: 'operations',
        SoldOutStats: 'operations',
        BranchCancellation: 'cancellations',
        TicketStatusStatistics: 'cancellations'
    };

    function setActiveStatisticButton(type) {
        if (typeof setActiveSubTab === 'function') {
            setActiveSubTab(type);
        }

        const mainTab = statTypeToMainTab[type];
        if (mainTab && typeof switchDashboardMainTab === 'function') {
            document.querySelectorAll('[data-main-tab]').forEach(function (btn) {
                const active = btn.dataset.mainTab === mainTab;
                btn.classList.toggle('border-blue-600', active);
                btn.classList.toggle('text-blue-600', active);
                btn.classList.toggle('dark:text-blue-400', active);
                btn.classList.toggle('border-transparent', !active);
                btn.classList.toggle('text-gray-500', !active);
                btn.classList.toggle('dark:text-gray-400', !active);
            });

            document.querySelectorAll('[data-sub-tabs]').forEach(function (panel) {
                panel.classList.toggle('hidden', panel.dataset.subTabs !== mainTab);
            });
        }
    }

    function destroyDashboardCharts() {
        Object.keys(window.dashboardCharts || {}).forEach(chartId => {
            if (window.dashboardCharts[chartId]) {
                window.dashboardCharts[chartId].destroy();
                delete window.dashboardCharts[chartId];
            }
        });
    }

    async function loadStatistic(type, page = 1, fromDate = '', toDate = '') {
        currentType = type;
        currentFromDate = fromDate || currentFromDate;
        currentToDate = toDate || currentToDate;
        setActiveStatisticButton(type);

        const placeholder = document.getElementById('placeholderText');
        const spinner = document.getElementById('loadingSpinner');
        const contentDiv = document.getElementById('dynamicContent');

        if (placeholder) placeholder.style.display = 'none';
        if (spinner) spinner.classList.remove('hidden');

        try {
            const params = new URLSearchParams();
            params.set('page', page);
            if (currentFromDate) params.set('fromDate', currentFromDate);
            if (currentToDate) params.set('toDate', currentToDate);

            const url = `/Dashboard/${type}Partial?${params.toString()}`;
            const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error('Lỗi tải dữ liệu hệ thống.');

            Object.keys(window.dashboardRangePickers || {}).forEach(closeDashboardRangePicker);
            destroyDashboardCharts();

            contentDiv.innerHTML = await response.text();
            executeDynamicScripts(contentDiv);
        } catch (error) {
            console.error(error);
            alert('Không thể lấy được dữ liệu thống kê, vui lòng kiểm tra lại!');
        } finally {
            if (spinner) spinner.classList.add('hidden');
        }
    }

    function executeDynamicScripts(container) {
        const scripts = Array.from(container.querySelectorAll('script'));
        scripts.forEach(oldScript => {
            const newScript = document.createElement('script');
            Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
            newScript.text = oldScript.textContent;
            document.body.appendChild(newScript);
            document.body.removeChild(newScript);
        });
    }

    function buildDashboardDetailUrl(action, fromDate, toDate, filterParam, filterValue) {
        const params = new URLSearchParams();
        if (fromDate) params.set('fromDate', fromDate);
        if (toDate) params.set('toDate', toDate);
        if (filterParam && filterValue) params.set(filterParam, filterValue);
        return `/Dashboard/${action}?${params.toString()}`;
    }

    function renderDashboardPieChart(chartId, labels, data, colors, labelText, onSliceClick, options) {
        const canvas = document.getElementById(chartId);
        if (!canvas || typeof Chart === 'undefined') return;

        options = options || {};
        const enableTableFilter = options.enableTableFilter === true;
        const valueSuffix = options.valueSuffix != null ? options.valueSuffix : '';

        window.dashboardCharts = window.dashboardCharts || {};

        if (window.dashboardCharts[chartId]) {
            window.dashboardCharts[chartId].destroy();
            delete window.dashboardCharts[chartId];
        }

        const numericData = (data || []).map(v => Number(v || 0));
        if (!numericData.some(v => v > 0)) return;

        const isDark = document.documentElement.classList.contains('dark');
        const legendColor = isDark ? '#d1d5db' : '#4b5563';
        const chartColors = (colors && colors.length > 0)
            ? colors
            : ['#8b5cf6', '#10b981', '#0ea5e9', '#f59e0b', '#ef4444', '#6b7280'];

        const legendOptions = {
            position: 'bottom',
            labels: { color: legendColor, boxWidth: 12, padding: 12 }
        };

        if (enableTableFilter && typeof window.createRevenuePieLegendClickHandler === 'function') {
            legendOptions.onClick = window.createRevenuePieLegendClickHandler();
        }

        const piePlugins = window.pieChartExternalLabelPlugin ? [window.pieChartExternalLabelPlugin] : [];

        window.dashboardCharts[chartId] = new Chart(canvas.getContext('2d'), {
            type: 'pie',
            plugins: piePlugins,
            data: {
                labels,
                datasets: [{
                    label: labelText,
                    data: numericData,
                    backgroundColor: chartColors,
                    borderWidth: 1,
                    borderColor: isDark ? '#1f2937' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: typeof window.getPieChartLayoutPadding === 'function'
                    ? { padding: window.getPieChartLayoutPadding() }
                    : undefined,
                plugins: {
                    legend: legendOptions,
                    tooltip: {
                        callbacks: {
                            label: typeof window.createPieChartTooltipLabel === 'function'
                                ? window.createPieChartTooltipLabel(valueSuffix)
                                : function (context) {
                                    const value = Number(context.raw || 0);
                                    return `${context.label}: ${value.toLocaleString('vi-VN')}${valueSuffix}`;
                                }
                        }
                    }
                },
                onClick: function (event, elements) {
                    if (elements.length > 0 && typeof onSliceClick === 'function') {
                        const url = onSliceClick(elements[0].index, labels);
                        if (url) {
                            window.location.href = url;
                        }
                    }
                },
                onHover: function (event, elements) {
                    if (typeof onSliceClick === 'function') {
                        event.native.target.style.cursor = elements.length ? 'pointer' : 'default';
                    }
                }
            }
        });

        if (enableTableFilter && typeof applyRevenueChartTableFilters === 'function') {
            applyRevenueChartTableFilters();
        }
    }

    // TỰ ĐỘNG LOAD BÁO CÁO MẶC ĐỊNH KHI VÀO TRANG (7 NGÀY GẦN NHẤT)
    document.addEventListener('DOMContentLoaded', function() {
        const today = new Date();
        const last7Days = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 6);
        const defaultFrom = toDateInputValue(last7Days);
        const defaultTo = toDateInputValue(today);

        if (typeof initDashboardTabs === 'function') {
            initDashboardTabs('@defaultMainTab', '@defaultStatType', defaultFrom, defaultTo);
        } else if (typeof loadStatistic === 'function') {
            loadStatistic('@defaultStatType', 1, defaultFrom, defaultTo);
        }
    });
</script>