@model Bus_ticket.ViewModels.LowOccupancyTripsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết Chuyến xe ít khách";
    ViewData["ReportTitle"] = "Chi tiết Chuyến xe ít khách";
    ViewData["ReportSubtitle"] = "Danh sách chuyến ít khách và khung giờ sold out";
    ViewData["PickerType"] = "LowOccupancyTripsDetail";
    ViewData["StatType"] = "LowOccupancyTrips";
    ViewData["ExportHandler"] = "exportLowOccupancyTripsDetailExcel";
    ViewData["ShowChartToggle"] = true;
    ViewData["ChartSectionId"] = "lowOccupancyTripsDetailCharts";
    ViewData["ChartInitFunction"] = "initializeLowOccupancyTripsDetailCharts";
    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/admin-assets/js/pie-chart-percent-labels.js?v=6"></script>
<script src="/admin-assets/js/dashboard-date-range.js?v=1"></script>
<script src="/admin-assets/js/dashboard-detail-charts.js?v=4"></script>

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full overflow-x-hidden">
    @await Html.PartialAsync("_ReportDetailHeader")
    @await Html.PartialAsync("_LowOccupancyTripsDetailChartsPartial", Model)
    @await Html.PartialAsync("_LowOccupancyTripsDetailTablesPartial", Model)
</div>

@await Html.PartialAsync("_ReportDetailDateScript")

<script>
    const lowOccupancyRouteName = @Html.Raw(Json.Serialize(ViewBag.RouteNameFilter as string ?? string.Empty));
    const lowOccupancyBusCode = @Html.Raw(Json.Serialize(ViewBag.BusCodeFilter as string ?? string.Empty));
    const lowOccupancyLicensePlate = @Html.Raw(Json.Serialize(ViewBag.LicensePlateFilter as string ?? string.Empty));

    function buildLowOccupancyTripsDetailUrl(options) {
        options = options || {};
        const params = new URLSearchParams();
        params.set('fromDate', detailFromDate);
        params.set('toDate', detailToDate);

        const tripCode = detailFilterParam === 'tripCode' ? detailFilterValue : '';
        const routeName = options.routeName !== undefined
            ? options.routeName
            : (document.getElementById('lowOccupancyRouteFilter')?.value || '').trim();
        const busCode = options.busCode !== undefined
            ? options.busCode
            : (document.getElementById('lowOccupancyBusCodeFilter')?.value || '').trim();
        const licensePlate = options.licensePlate !== undefined
            ? options.licensePlate
            : (document.getElementById('lowOccupancyLicensePlateFilter')?.value || '').trim();

        if (tripCode) params.set('tripCode', tripCode);
        if (routeName) params.set('routeName', routeName);
        if (busCode) params.set('busCode', busCode);
        if (licensePlate) params.set('licensePlate', licensePlate);

        return `/Dashboard/LowOccupancyTripsDetail?${params.toString()}`;
    }

    window.applyLowOccupancyTableFilters = function () {
        window.location.href = buildLowOccupancyTripsDetailUrl();
    };

    window.clearLowOccupancyTableFilters = function () {
        window.location.href = buildLowOccupancyTripsDetailUrl({
            routeName: '',
            busCode: '',
            licensePlate: ''
        });
    };

    window.dashboardDateRangeApplyHandlers[detailPickerType] = function (start, end) {
        const params = new URLSearchParams();
        params.set('fromDate', start);
        params.set('toDate', end);

        if (detailFilterParam === 'tripCode' && detailFilterValue) {
            params.set('tripCode', detailFilterValue);
        }
        if (lowOccupancyRouteName) params.set('routeName', lowOccupancyRouteName);
        if (lowOccupancyBusCode) params.set('busCode', lowOccupancyBusCode);
        if (lowOccupancyLicensePlate) params.set('licensePlate', lowOccupancyLicensePlate);

        window.location.href = `/Dashboard/LowOccupancyTripsDetail?${params.toString()}`;
    };

    document.addEventListener('DOMContentLoaded', function () {
        ['lowOccupancyBusCodeFilter', 'lowOccupancyLicensePlateFilter'].forEach(function (id) {
            const input = document.getElementById(id);
            if (input) {
                input.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        applyLowOccupancyTableFilters();
                    }
                });
            }
        });
    });

    function exportLowOccupancyTripsDetailExcel() {
        const range = getDashboardDateRangeValues('LowOccupancyTripsDetail', detailFromDate, detailToDate);
        window.location.href = `/Dashboard/ExportLowOccupancyTrips?fromDate=${range.start}&toDate=${range.end}&occupancyThreshold=@Model.OccupancyThreshold`;
    }
</script>
