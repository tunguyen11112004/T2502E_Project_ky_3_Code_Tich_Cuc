@model Bus_ticket.ViewModels.DashboardRevenueViewModel

@{
    var paymentSummaries = PaymentMethodDisplayHelper.BuildSummaries(Model?.TableData);

    var fromDate = DateTime.TryParse(ViewBag.FromDateValue as string, out var parsedFrom)
        ? parsedFrom.Date
        : DateTime.Today.AddDays(-30);
    var toDate = DateTime.TryParse(ViewBag.ToDateValue as string, out var parsedTo)
        ? parsedTo.Date
        : DateTime.Today;

    var periodGrouping = RevenuePeriodGroupingHelper.Build(Model?.TableData, fromDate, toDate);
    var revenueByPeriod = periodGrouping.DetailGroups;

    var totalRevenue = Model?.TableData?.Sum(x => x.Amount) ?? 0m;
    var revenueByBusClass = Model?.TableData?
        .GroupBy(x => string.IsNullOrWhiteSpace(x.BusClass) ? "Khác" : x.BusClass)
        .Select(g => new {
            BusClass = g.Key,
            TicketCount = g.Count(),
            Revenue = g.Sum(x => x.Amount),
            Share = totalRevenue > 0 ? (g.Sum(x => x.Amount) / totalRevenue * 100) : 0m
        })
        .OrderByDescending(x => x.Revenue)
        .ToList();

    var routeFilterOptions = ViewBag.RouteFilterOptions as List<string> ?? new List<string>();
    var busClassFilterOptions = ViewBag.BusClassFilterOptions as List<string> ?? new List<string>();
    var routeNameFilter = ViewBag.RouteNameFilter as string ?? string.Empty;
    var busClassFilter = ViewBag.BusClassFilter as string ?? string.Empty;
    var hasTableFilters = !string.IsNullOrWhiteSpace(routeNameFilter) || !string.IsNullOrWhiteSpace(busClassFilter);
}

<div class="space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm w-full">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-4">
                <div>
                    <h3 class="text-md font-semibold text-gray-900 dark:text-white">@periodGrouping.TableTitle</h3>
                    <p class="text-xs text-gray-500 mt-1">@periodGrouping.TableSubtitle</p>
                </div>
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label for="totalRevenueRouteFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tuyến đường</label>
                        <select id="totalRevenueRouteFilter"
                                onchange="applyTotalRevenueTableFilters()"
                                class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[220px] p-2 shadow-sm">
                            <option value="">Tất cả tuyến</option>
                            @foreach (var route in routeFilterOptions)
                            {
                                if (string.Equals(route, routeNameFilter, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@route" selected="selected">@route</option>
                                }
                                else
                                {
                                    <option value="@route">@route</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label for="totalRevenueBusClassFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Hạng xe</label>
                        <select id="totalRevenueBusClassFilter"
                                onchange="applyTotalRevenueTableFilters()"
                                class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[220px] p-2 shadow-sm">
                            <option value="">Tất cả hạng xe</option>
                            @foreach (var busClassOption in busClassFilterOptions)
                            {
                                if (string.Equals(busClassOption, busClassFilter, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@busClassOption" selected="selected">@busClassOption</option>
                                }
                                else
                                {
                                    <option value="@busClassOption">@busClassOption</option>
                                }
                            }
                        </select>
                    </div>
                    @if (hasTableFilters)
                    {
                        <button type="button"
                                onclick="clearTotalRevenueTableFilters()"
                                class="px-3 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
                            Xóa lọc bảng
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="overflow-x-auto max-h-[480px]">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10 shadow-sm">
                <tr>
                    <th scope="col" class="px-6 py-4">@periodGrouping.PeriodColumnHeader</th>
                    <th scope="col" class="px-6 py-4">TUYẾN ĐƯỜNG</th>
                    <th scope="col" class="px-6 py-4">HẠNG XE</th>
                    <th scope="col" class="px-6 py-4 text-center">SỐ VÉ</th>
                    <th scope="col" class="px-6 py-4 text-right">DOANH THU</th>
                </tr>
                </thead>
                <tbody>
                @if (revenueByPeriod != null && revenueByPeriod.Any())
                {
                    foreach (var item in revenueByPeriod)
                    {
                        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                            data-filter-bus-class="@item.BusClass"
                            data-filter-route-name="@item.RouteName">
                            <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white whitespace-nowrap">@item.DisplayLabel</td>
                            <td class="px-6 py-4 text-gray-900 dark:text-white">@item.RouteName</td>
                            <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">@item.BusClass</td>
                            <td class="px-6 py-4 text-center font-medium text-blue-600 dark:text-blue-400">@item.TicketCount.ToString("N0")</td>
                            <td class="px-6 py-4 font-bold text-emerald-600 dark:text-emerald-400 text-right whitespace-nowrap">@item.Revenue.ToString("N0") đ</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-gray-500">Không có dữ liệu trong khoảng thời gian này.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
            <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
                <h3 class="text-md font-semibold text-gray-900 dark:text-white">Đối soát nguồn thu</h3>
                <p class="text-xs text-gray-500 mt-1">Phân bổ dòng tiền theo cổng thanh toán thực tế</p>
            </div>

            <div class="overflow-x-auto h-[350px]">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10 shadow-sm">
                    <tr>
                        <th scope="col" class="px-5 py-4">PHƯƠNG THỨC</th>
                        <th scope="col" class="px-5 py-4 text-center">GIAO DỊCH</th>
                        <th scope="col" class="px-5 py-4 text-right">SỐ TIỀN THỰC THU</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var method in paymentSummaries)
                    {
                        var dotColorClass = PaymentMethodDisplayHelper.TableDotColors.TryGetValue(method.Method, out var colorClass)
                            ? colorClass
                            : "bg-gray-500";

                        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                            data-filter-payment-method="@method.Method">
                            <td class="px-5 py-3 font-semibold text-gray-900 dark:text-white">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full @dotColorClass"></span>
                                    @method.Method
                                </div>
                            </td>
                            <td class="px-5 py-3 text-center">@method.TransactionCount.ToString("N0")</td>
                            <td class="px-5 py-3 font-bold text-teal-600 dark:text-teal-400 text-right">@method.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
            <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
                <h3 class="text-md font-semibold text-gray-900 dark:text-white">Tỷ trọng theo Hạng Xe</h3>
                <p class="text-xs text-gray-500 mt-1">Phân bổ doanh thu theo loại hạng xe</p>
            </div>

            <div class="overflow-x-auto h-[350px]">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10 shadow-sm">
                    <tr>
                        <th scope="col" class="px-5 py-4">HẠNG XE</th>
                        <th scope="col" class="px-5 py-4 text-center">SỐ VÉ</th>
                        <th scope="col" class="px-5 py-4 text-right">TỶ TRỌNG</th>
                        <th scope="col" class="px-5 py-4 text-right">DOANH THU</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (revenueByBusClass != null && revenueByBusClass.Any())
                    {
                        foreach (var item in revenueByBusClass)
                        {
                            <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                                data-filter-bus-class="@item.BusClass">
                                <td class="px-5 py-3 font-semibold text-gray-900 dark:text-white">@item.BusClass</td>
                                <td class="px-5 py-3 text-center font-medium text-blue-600 dark:text-blue-400">@item.TicketCount.ToString("N0")</td>
                                <td class="px-5 py-3 text-right font-semibold text-purple-600 dark:text-purple-400">@item.Share.ToString("0.0")%</td>
                                <td class="px-5 py-3 font-bold text-emerald-600 dark:text-emerald-400 text-right">@item.Revenue.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-10 text-center text-gray-500">Chưa có dữ liệu hạng xe.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
