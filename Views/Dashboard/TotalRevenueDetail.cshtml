@model Bus_ticket.ViewModels.DashboardRevenueViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết Tổng Doanh Thu";

    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
    var busClassFilter = ViewBag.BusClassFilter as string ?? string.Empty;
    var routeNameFilter = ViewBag.RouteNameFilter as string ?? string.Empty;
    var paymentMethodFilter = ViewBag.PaymentMethodFilter as string ?? string.Empty;
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/admin-assets/js/pie-chart-percent-labels.js?v=6"></script>
<script src="/admin-assets/js/dashboard-date-range.js?v=1"></script>
<script src="/admin-assets/js/revenue-chart-table-filters.js?v=3"></script>

<style>
    .dashboard-range-popup {
        width: min(720px, calc(100vw - 32px));
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    }
</style>

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full overflow-x-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Quay lại Dashboard
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Chi tiết Tổng Doanh Thu</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Thống kê theo tuần và đối soát nguồn thu theo phương thức thanh toán</p>
            @if (!string.IsNullOrWhiteSpace(paymentMethodFilter))
            {
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-900/30 border border-indigo-200 dark:border-indigo-800 text-sm text-indigo-700 dark:text-indigo-300 mr-2">
                    <span>Đang lọc thanh toán: <strong>@paymentMethodFilter</strong></span>
                    <a asp-controller="Dashboard"
                       asp-action="TotalRevenueDetail"
                       asp-route-fromDate="@fromDateValue"
                       asp-route-toDate="@toDateValue"
                       asp-route-busClass="@busClassFilter"
                       asp-route-routeName="@routeNameFilter"
                       class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
                        Bỏ lọc
                    </a>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(routeNameFilter))
            {
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-50 dark:bg-purple-900/30 border border-purple-200 dark:border-purple-800 text-sm text-purple-700 dark:text-purple-300 mr-2">
                    <span>Đang lọc tuyến: <strong>@routeNameFilter</strong></span>
                    <a asp-controller="Dashboard"
                       asp-action="TotalRevenueDetail"
                       asp-route-fromDate="@fromDateValue"
                       asp-route-toDate="@toDateValue"
                       asp-route-busClass="@busClassFilter"
                       asp-route-paymentMethod="@paymentMethodFilter"
                       class="text-purple-600 dark:text-purple-400 hover:underline font-medium">
                        Bỏ lọc
                    </a>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(busClassFilter))
            {
                <div class="mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-50 dark:bg-purple-900/30 border border-purple-200 dark:border-purple-800 text-sm text-purple-700 dark:text-purple-300">
                    <span>Đang lọc hạng xe: <strong>@busClassFilter</strong></span>
                    <a asp-controller="Dashboard"
                       asp-action="TotalRevenueDetail"
                       asp-route-fromDate="@fromDateValue"
                       asp-route-toDate="@toDateValue"
                       asp-route-routeName="@routeNameFilter"
                       asp-route-paymentMethod="@paymentMethodFilter"
                       class="text-purple-600 dark:text-purple-400 hover:underline font-medium">
                        Bỏ lọc
                    </a>
                </div>
            }
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="button"
                    onclick="toggleTotalRevenueDetailCharts(this)"
                    class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 hover:bg-blue-100 dark:hover:bg-blue-900/50 border border-blue-200 dark:border-blue-800 rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                <span data-chart-toggle-label>Hiện biểu đồ chi tiết</span>
            </button>

            <input type="text"
                   id="date_range_TotalRevenueDetail"
                   readonly
                   class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2.5 cursor-pointer shadow-sm"
                   placeholder="Chọn khoảng ngày..." />

            <button type="button"
                    onclick="exportTotalRevenueDetailExcel()"
                    class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-lg text-sm px-4 py-2.5 shadow-sm transition-colors inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Xuất Excel
            </button>
        </div>
    </div>

    @await Html.PartialAsync("_TotalRevenueDetailChartsPartial", Model)
    @await Html.PartialAsync("_TotalRevenueDetailTablesPartial", Model)
</div>

<script>
    const detailFromDate = @Html.Raw(Json.Serialize(fromDateValue));
    const detailToDate = @Html.Raw(Json.Serialize(toDateValue));
    const detailBusClass = @Html.Raw(Json.Serialize(busClassFilter));
    const detailRouteName = @Html.Raw(Json.Serialize(routeNameFilter));
    const detailPaymentMethod = @Html.Raw(Json.Serialize(paymentMethodFilter));

    function buildTotalRevenueDetailPageUrl(fromDate, toDate, routeName, busClass, paymentMethod) {
        const params = new URLSearchParams();
        params.set('fromDate', fromDate);
        params.set('toDate', toDate);
        if (routeName) params.set('routeName', routeName);
        if (busClass) params.set('busClass', busClass);
        if (paymentMethod) params.set('paymentMethod', paymentMethod);
        return `/Dashboard/TotalRevenueDetail?${params.toString()}`;
    }

    window.applyTotalRevenueTableFilters = function () {
        const route = document.getElementById('totalRevenueRouteFilter')?.value || '';
        const busClass = document.getElementById('totalRevenueBusClassFilter')?.value || '';
        window.location.href = buildTotalRevenueDetailPageUrl(detailFromDate, detailToDate, route, busClass, detailPaymentMethod);
    };

    window.clearTotalRevenueTableFilters = function () {
        window.location.href = buildTotalRevenueDetailPageUrl(detailFromDate, detailToDate, '', '', detailPaymentMethod);
    };

    window.dashboardDateRangeApplyHandlers['TotalRevenueDetail'] = function (start, end) {
        window.location.href = buildTotalRevenueDetailPageUrl(start, end, detailRouteName, detailBusClass, detailPaymentMethod);
    };

    function exportTotalRevenueDetailExcel() {
        const range = getDashboardDateRangeValues('TotalRevenueDetail', detailFromDate, detailToDate);
        window.location.href = `/Dashboard/ExportTotalRevenue?startDate=${range.start}&endDate=${range.end}`;
    }

    document.addEventListener('DOMContentLoaded', function () {
        initializeDashboardDateRangePicker('TotalRevenueDetail', detailFromDate, detailToDate);
    });
</script>
