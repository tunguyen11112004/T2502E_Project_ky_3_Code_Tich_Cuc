@{
    var pickerType = ViewData["PickerType"] as string ?? string.Empty;
    var detailAction = ViewData["DetailAction"] as string ?? ViewData["StatType"] as string ?? string.Empty;
    var fromDateValue = ViewBag.FromDateValue as string ?? string.Empty;
    var toDateValue = ViewBag.ToDateValue as string ?? string.Empty;
    var filterParamName = ViewBag.FilterParamName as string ?? string.Empty;
    var filterParamValue = ViewBag.FilterParamValue as string ?? string.Empty;
}

<script>
    const detailPickerType = @Html.Raw(Json.Serialize(pickerType));
    const detailAction = @Html.Raw(Json.Serialize(detailAction));
    const detailFromDate = @Html.Raw(Json.Serialize(fromDateValue));
    const detailToDate = @Html.Raw(Json.Serialize(toDateValue));
    const detailFilterParam = @Html.Raw(Json.Serialize(filterParamName));
    const detailFilterValue = @Html.Raw(Json.Serialize(filterParamValue));

    window.dashboardDateRangeApplyHandlers[detailPickerType] = function (start, end) {
        const params = new URLSearchParams();
        params.set('fromDate', start);
        params.set('toDate', end);
        if (detailFilterParam && detailFilterValue) {
            params.set(detailFilterParam, detailFilterValue);
        }
        window.location.href = `/Dashboard/${detailAction}?${params.toString()}`;
    };

    document.addEventListener('DOMContentLoaded', function () {
        initializeDashboardDateRangePicker(detailPickerType, detailFromDate, detailToDate);
    });

    window.applyReportDetailTableFilter = function (selectElementId) {
        const value = document.getElementById(selectElementId)?.value || '';
        const params = new URLSearchParams();
        params.set('fromDate', detailFromDate);
        params.set('toDate', detailToDate);
        if (detailFilterParam && value) {
            params.set(detailFilterParam, value);
        }
        window.location.href = `/Dashboard/${detailAction}?${params.toString()}`;
    };

    window.clearReportDetailTableFilter = function () {
        const params = new URLSearchParams();
        params.set('fromDate', detailFromDate);
        params.set('toDate', detailToDate);
        window.location.href = `/Dashboard/${detailAction}?${params.toString()}`;
    };
</script>
