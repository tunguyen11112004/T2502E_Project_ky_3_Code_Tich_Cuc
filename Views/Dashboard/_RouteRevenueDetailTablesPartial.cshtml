@model Bus_ticket.ViewModels.RouteRevenueReportViewModel

@{
    var items = Model.Items
        .OrderByDescending(x => x.TotalRevenue)
        .ToList();
    var routeFilterOptions = ViewBag.RouteFilterOptions as List<string> ?? new List<string>();
    var routeNameFilter = ViewBag.FilterParamValue as string ?? string.Empty;
    var hasTableFilter = !string.IsNullOrWhiteSpace(routeNameFilter);
}

<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
    <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-4">
            <div>
                <h3 class="text-md font-semibold text-gray-900 dark:text-white">Bảng doanh thu theo tuyến đường</h3>
                <p class="text-xs text-gray-500 mt-1">Sắp xếp giảm dần theo doanh thu booking đã thanh toán</p>
            </div>
            @if (routeFilterOptions.Any())
            {
                <div class="flex flex-wrap items-end gap-3">
                    <div>
                        <label for="routeRevenueRouteFilter" class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Tuyến đường</label>
                        <select id="routeRevenueRouteFilter"
                                onchange="applyReportDetailTableFilter('routeRevenueRouteFilter')"
                                class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2 shadow-sm">
                            <option value="">Tất cả tuyến</option>
                            @foreach (var route in routeFilterOptions)
                            {
                                if (string.Equals(route, routeNameFilter, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@route" selected="selected">@route</option>
                                }
                                else
                                {
                                    <option value="@route">@route</option>
                                }
                            }
                        </select>
                    </div>
                    @if (hasTableFilter)
                    {
                        <button type="button"
                                onclick="clearReportDetailTableFilter()"
                                class="px-3 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors">
                            Xóa lọc bảng
                        </button>
                    }
                </div>
            }
        </div>
    </div>
    <div class="overflow-x-auto max-h-[520px]">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10">
            <tr>
                <th class="px-6 py-4">STT</th>
                <th class="px-6 py-4">Tuyến đường</th>
                <th class="px-6 py-4 text-center">Booking</th>
                <th class="px-6 py-4 text-center">Vé bán</th>
                <th class="px-6 py-4 text-right">Doanh thu</th>
                <th class="px-6 py-4 text-right">Tỷ lệ</th>
            </tr>
            </thead>
            <tbody>
            @if (!items.Any())
            {
                <tr><td colspan="6" class="px-6 py-10 text-center text-gray-500">Không có dữ liệu hiển thị.</td></tr>
            }
            else
            {
                for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                        <td class="px-6 py-4 font-bold text-amber-500">#@(i + 1)</td>
                        <td class="px-6 py-4 font-semibold text-gray-900 dark:text-white">@item.RouteName</td>
                        <td class="px-6 py-4 text-center">@item.TotalBookings.ToString("N0")</td>
                        <td class="px-6 py-4 text-center">@item.TotalTickets.ToString("N0")</td>
                        <td class="px-6 py-4 text-right font-bold text-emerald-600 dark:text-emerald-400">@item.TotalRevenue.ToString("N0") đ</td>
                        <td class="px-6 py-4 text-right font-semibold">@item.Percentage.ToString("N2")%</td>
                    </tr>
                }
            }
            </tbody>
            <tfoot class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700">
            <tr>
                <td colspan="2" class="px-6 py-4 font-bold text-gray-900 dark:text-white">Tổng cộng</td>
                <td class="px-6 py-4 text-center font-bold text-gray-900 dark:text-white">@Model.GrandTotalBookings.ToString("N0")</td>
                <td class="px-6 py-4 text-center font-bold text-gray-900 dark:text-white">@Model.GrandTotalTickets.ToString("N0")</td>
                <td class="px-6 py-4 text-right font-bold text-emerald-600 dark:text-emerald-400">@Model.GrandTotalRevenue.ToString("N0") đ</td>
                <td class="px-6 py-4 text-right font-bold text-gray-900 dark:text-white">@(Model.GrandTotalRevenue > 0 ? "100.00%" : "0.00%")</td>
            </tr>
            </tfoot>
        </table>
    </div>
</div>
