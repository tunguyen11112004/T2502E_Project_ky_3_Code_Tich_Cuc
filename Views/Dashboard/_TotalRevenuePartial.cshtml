@model Bus_ticket.ViewModels.DashboardRevenueViewModel
@using System.Globalization

@{
// 1. TÍNH TOÁN KPI CƠ BẢN
decimal kpiTotalRevenue = 0;
int kpiTotalTickets = 0;
decimal kpiAvgTicket = 0;

int kpiCanceled = Model?.TotalCanceled ?? 0;

if (Model?.TableData?.Any() == true)
{
kpiTotalRevenue = Model.TableData.Sum(x => x.Amount);
kpiTotalTickets = Model.TableData.Count;
kpiAvgTicket = kpiTotalTickets > 0 ? (kpiTotalRevenue / kpiTotalTickets) : 0;
}

// ==========================================
// HÀM CHUẨN HÓA TÊN CỔNG THANH TOÁN (Từ DB -> UI)
// ==========================================
string GetPaymentDisplayName(string dbValue)
{
if (string.IsNullOrWhiteSpace(dbValue)) return "Khác";

string val = dbValue.ToLower();

if (val.Contains("cash") || val.Contains("tiền mặt") || val.Contains("quầy"))
return "Thanh toán tại quầy";

if (val.Contains("vnpay"))
return "VNPAY (Quét mã QR)";

if (val.Contains("momo"))
return "MOMO (Quét mã QR)";

if (val.Contains("payos") || val.Contains("banking") || val.Contains("chuyển khoản"))
return "Thanh toán chuyển khoản QR (PayOS)";

return "Khác";
}

// ==========================================
// 2. DỮ LIỆU BẢNG: ĐỐI SOÁT THANH TOÁN (ÉP 4 CỔNG CHUẨN)
// ==========================================
var expectedMethods = new List<string> {
"Thanh toán tại quầy",
"VNPAY (Quét mã QR)",
"MOMO (Quét mã QR)",
"Thanh toán chuyển khoản QR (PayOS)"
};

var finalPaymentMethods = expectedMethods.Select(m =>
{
var match = Model?.TableData?
.Where(x => GetPaymentDisplayName(x.PaymentMethod) == m)
.ToList();

return new
{
Method = m,
TransactionCount = match?.Count ?? 0,
TotalAmount = match?.Sum(x => x.Amount) ?? 0m
};
}).ToList();

// Gom những cổng lạ (nếu có) vào mục "Khác"
var otherMatch = Model?.TableData?.Where(x => GetPaymentDisplayName(x.PaymentMethod) == "Khác").ToList();
if (otherMatch != null && otherMatch.Any())
{
finalPaymentMethods.Add(new
{
Method = "Khác",
TransactionCount = otherMatch.Count,
TotalAmount = otherMatch.Sum(x => x.Amount)
});
}

var revenueByPaymentMethod = finalPaymentMethods
.OrderByDescending(x => x.TotalAmount)
.ToList();

var paymentColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase) {
{ "Thanh toán tại quầy", "bg-amber-500" },
{ "VNPAY (Quét mã QR)", "bg-blue-500" },
{ "MOMO (Quét mã QR)", "bg-pink-500" },
{ "Thanh toán chuyển khoản QR (PayOS)", "bg-indigo-500" },
{ "Khác", "bg-gray-500" }
};

// ==========================================
// 3. DỮ LIỆU BẢNG: GOM NHÓM THEO TUẦN
// ==========================================
var cal = CultureInfo.InvariantCulture.Calendar;
var revenueByWeek = Model?.TableData?
.GroupBy(x => new {
Year = x.PaymentDate.Year,
Week = cal.GetWeekOfYear(x.PaymentDate, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday)
})
.Select(g => new {
Year = g.Key.Year,
Week = g.Key.Week,
DisplayDate = $"Tuần {g.Key.Week} ({g.Min(x => x.PaymentDate):dd/MM} - {g.Max(x => x.PaymentDate):dd/MM})",
QueryStartDate = g.Min(x => x.PaymentDate).ToString("yyyy-MM-dd"),
QueryEndDate = g.Max(x => x.PaymentDate).ToString("yyyy-MM-dd"),
TicketCount = g.Count(),
Revenue = g.Sum(x => x.Amount)
})
.OrderByDescending(x => x.Year).ThenByDescending(x => x.Week)
.ToList();

// ==========================================
// 4. DATA CHO LINE CHART THEO TUẦN
// ==========================================
var revenueLineData = revenueByWeek?
.OrderBy(x => x.Year).ThenBy(x => x.Week)
.ToList();

var lineLabels = revenueLineData?.Select(x => x.DisplayDate).ToList() ?? new List<string>();
var lineValues = revenueLineData?.Select(x => x.Revenue).ToList() ?? new List<decimal>();
var lineQueryDates = revenueLineData?.Select(x => $"{x.QueryStartDate}|{x.QueryEndDate}").ToList() ?? new List<string>();
}

<div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Báo cáo Tổng Doanh Thu</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Phân bổ dòng tiền và hiệu suất bán vé toàn hệ thống</p>
    </div>
    <div class="flex items-center gap-3">
        <input type="text" id="date_range_TotalRevenue" readonly
               class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-[260px] p-2.5 cursor-pointer shadow-sm"
               placeholder="Chọn khoảng ngày...">

        <button onclick="exportTotalRevenueExcel()" class="bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-lg text-sm px-4 py-2.5 shadow-sm transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Xuất Excel
        </button>
    </div>
</div>

<!-- CỤM KPI CARDS -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Tổng doanh thu</p>
            <h4 class="text-xl font-bold text-emerald-600 dark:text-emerald-400">@kpiTotalRevenue.ToString("N0") đ</h4>
        </div>
        <div class="p-3 bg-emerald-100 text-emerald-600 rounded-lg dark:bg-emerald-900/30 dark:text-emerald-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Tổng vé bán</p>
            <h4 class="text-xl font-bold text-blue-600 dark:text-blue-400">@kpiTotalTickets.ToString("N0")</h4>
        </div>
        <div class="p-3 bg-blue-100 text-blue-600 rounded-lg dark:bg-blue-900/30 dark:text-blue-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Giá trị trung bình / Vé</p>
            <h4 class="text-xl font-bold text-amber-500 dark:text-amber-400">@kpiAvgTicket.ToString("N0") đ</h4>
        </div>
        <div class="p-3 bg-amber-100 text-amber-600 rounded-lg dark:bg-amber-900/30 dark:text-amber-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm flex items-center justify-between">
        <div>
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Vé hoàn / Hủy</p>
            <h4 class="text-xl font-bold text-red-500 dark:text-red-400">@kpiCanceled.ToString("N0")</h4>
        </div>
        <div class="p-3 bg-red-100 text-red-600 rounded-lg dark:bg-red-900/30 dark:text-red-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
    </div>
</div>

<!-- BIỂU ĐỒ ĐƯỜNG: BIẾN ĐỘNG DOANH THU THEO TUẦN -->
<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm mb-6 w-full">
    <div class="flex justify-between items-center mb-4">
        <div>
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Biến động doanh thu theo tuần</h3>
            <p class="text-xs text-gray-500 mt-1">Click vào điểm bất kỳ trên biểu đồ để xem chi tiết thống kê của tuần đó</p>
        </div>
        <a href="/Dashboard/RouteRevenue" target="_blank" class="text-sm font-medium text-blue-600 hover:text-blue-700 hover:underline flex items-center gap-1">
            Mở trang chi tiết <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
    </div>

    <div class="relative h-[320px] w-full flex justify-center">
        <canvas id="revenueLineChart"></canvas>
    </div>
</div>

<!-- CỤM PIE CHARTS -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-4">Tỷ trọng theo Hạng Xe</h3>
        <div class="relative h-[280px] w-full flex justify-center">
            <canvas id="totalRevenueChart"></canvas>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 shadow-sm">
        <h3 class="text-md font-semibold text-gray-900 dark:text-white mb-4">Theo phương thức thanh toán</h3>
        <div class="relative h-[280px] w-full flex justify-center">
            <canvas id="paymentMethodChart"></canvas>
        </div>
    </div>
</div>

<!-- BẢNG THỐNG KÊ (Theo Tuần & Nguồn Thu) -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

    <!-- BẢNG 1: DOANH THU THEO TUẦN -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Thống kê theo tuần</h3>
            <p class="text-xs text-gray-500 mt-1">Biến động lượng vé và dòng tiền từng tuần</p>
        </div>

        <div class="overflow-x-auto h-[350px]">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10 shadow-sm">
                <tr>
                    <th scope="col" class="px-5 py-4">TUẦN</th>
                    <th scope="col" class="px-5 py-4 text-center">SỐ VÉ</th>
                    <th scope="col" class="px-5 py-4 text-right">DOANH THU</th>
                </tr>
                </thead>
                <tbody>
                @if (revenueByWeek != null && revenueByWeek.Any())
                {
                foreach (var item in revenueByWeek)
                {
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    <td class="px-5 py-3 font-semibold text-gray-900 dark:text-white">
                        <div class="flex items-center gap-2">
                            <i class="bx bx-calendar text-gray-400"></i>
                            @item.DisplayDate
                        </div>
                    </td>
                    <td class="px-5 py-3 text-center font-medium text-blue-600 dark:text-blue-400">
                        @item.TicketCount.ToString("N0")
                    </td>
                    <td class="px-5 py-3 font-bold text-emerald-600 dark:text-emerald-400 text-right">
                        @item.Revenue.ToString("N0") đ
                    </td>
                </tr>
                }
                }
                else
                {
                <tr>
                    <td colspan="3" class="px-6 py-10 text-center text-gray-500">Không có dữ liệu trong khoảng thời gian này.</td>
                </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BẢNG 2: ĐỐI SOÁT NGUỒN THU DỮ LIỆU THẬT -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800/50">
            <h3 class="text-md font-semibold text-gray-900 dark:text-white">Đối soát nguồn thu</h3>
            <p class="text-xs text-gray-500 mt-1">Phân bổ dòng tiền theo cổng thanh toán thực tế</p>
        </div>

        <div class="overflow-x-auto h-[350px]">
            <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-gray-100 dark:bg-gray-700 dark:text-gray-300 sticky top-0 z-10 shadow-sm">
                <tr>
                    <th scope="col" class="px-5 py-4">PHƯƠNG THỨC</th>
                    <th scope="col" class="px-5 py-4 text-center">GIAO DỊCH</th>
                    <th scope="col" class="px-5 py-4 text-right">SỐ TIỀN THỰC THU</th>
                </tr>
                </thead>
                <tbody>
                @if (revenueByPaymentMethod != null && revenueByPaymentMethod.Any())
                {
                foreach (var method in revenueByPaymentMethod)
                {
                var dotColorClass = paymentColors.ContainsKey(method.Method) ? paymentColors[method.Method] : "bg-gray-500";

                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    <td class="px-5 py-3 font-semibold text-gray-900 dark:text-white">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full @dotColorClass"></span>
                            @method.Method
                        </div>
                    </td>
                    <td class="px-5 py-3 text-center">@method.TransactionCount.ToString("N0")</td>
                    <td class="px-5 py-3 font-bold text-teal-600 dark:text-teal-400 text-right">@method.TotalAmount.ToString("N0") đ</td>
                </tr>
                }
                }
                else
                {
                <tr>
                    <td colspan="3" class="px-6 py-10 text-center text-gray-500">Chưa có giao dịch nào.</td>
                </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // 1. Gắn sự kiện chọn ngày
    initializeDashboardDateRangePicker('TotalRevenue', '@ViewBag.FromDateValue', '@ViewBag.ToDateValue');

    // 2. Data cho Pie Chart: Hạng Xe
    var labelsSeat = @Html.Raw(Json.Serialize(Model?.ChartData.Select(c => c.Category) ?? new List<string>()));
    var dataSeat = @Html.Raw(Json.Serialize(Model?.ChartData.Select(c => c.TotalRevenue) ?? new List<decimal>()));
    renderDashboardPieChart('totalRevenueChart', labelsSeat, dataSeat, [], 'Tổng Doanh Thu');

    // 3. Data cho Pie Chart: Thanh toán
    var labelsPayment = @Html.Raw(Json.Serialize(revenueByPaymentMethod?.Select(x => x.Method) ?? new List<string>()));
    var dataPayment = @Html.Raw(Json.Serialize(revenueByPaymentMethod?.Select(x => x.TotalAmount) ?? new List<decimal>()));

    renderDashboardPieChart('paymentMethodChart', labelsPayment, dataPayment, [], 'Thanh toán');

    // 4. Khởi tạo Line Chart
    var lineLabels = @Html.Raw(Json.Serialize(lineLabels));
    var lineValues = @Html.Raw(Json.Serialize(lineValues));
    var lineQueryDates = @Html.Raw(Json.Serialize(lineQueryDates));

    var lineCanvas = document.getElementById('revenueLineChart');
    if (lineCanvas) {
        var lineCtx = lineCanvas.getContext('2d');

        if (window.dashboardCharts && window.dashboardCharts['revenueLineChart']) {
            window.dashboardCharts['revenueLineChart'].destroy();
        }

        window.dashboardCharts = window.dashboardCharts || {};
        window.dashboardCharts['revenueLineChart'] = new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: lineLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: lineValues,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 2,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#10b981',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let value = context.raw || 0;
                                return 'Doanh thu: ' + value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000) return (value / 1000000) + ' Tr';
                                if (value >= 1000) return (value / 1000) + ' K';
                                return value;
                            }
                        }
                    }
                },
                onClick: function(event, elements) {
                    if (elements.length > 0) {
                        var index = elements[0].index;

                        var dates = lineQueryDates[index].split('|');
                        var startDate = dates[0];
                        var endDate = dates[1];

                        var url = `/Dashboard/RouteRevenue?fromDate=${startDate}&toDate=${endDate}`;
                        window.open(url, '_blank');
                    }
                },
                onHover: function(event, elements) {
                    event.native.target.style.cursor = elements.length ? 'pointer' : 'default';
                }
            }
        });
    }

    // 5. Hàm Xuất Excel
    function exportTotalRevenueExcel() {
        var start = currentFromDate || '@ViewBag.FromDateValue';
        var end = currentToDate || '@ViewBag.ToDateValue';
        window.location.href = `/Dashboard/ExportTotalRevenue?startDate=${start}&endDate=${end}`;
    }
</script>