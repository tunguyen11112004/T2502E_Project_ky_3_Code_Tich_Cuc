@model List<Bus_ticket.Models.BusRoute>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Tuyến đường";

    string searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    string departureFilter = ViewBag.DeparturePoint as string ?? string.Empty;
    string destinationFilter = ViewBag.DestinationPoint as string ?? string.Empty;
    var departureOptions = ViewBag.DepartureOptions as List<string> ?? new List<string>();
    var destinationOptions = ViewBag.DestinationOptions as List<string> ?? new List<string>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    long totalItems = ViewBag.TotalItems ?? 0;
    int pageSize = ViewBag.PageSize ?? 10;

    long startItem = totalItems == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    long endItem = (currentPage * pageSize) > totalItems ? totalItems : (currentPage * pageSize);
    bool hasActiveFilter = !string.IsNullOrEmpty(searchTerm)
                           || !string.IsNullOrEmpty(departureFilter)
                           || !string.IsNullOrEmpty(destinationFilter);
}

<div class="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full overflow-x-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                Danh mục Tuyến đường
            </h1>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                Quản lý các tuyến xe được sử dụng khi tạo chuyến.
            </p>
        </div>

        <button type="button"
                onclick="showRouteModal('modal-route-create')"
                class="inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-gray-900 bg-amber-400 hover:bg-amber-500 rounded-lg transition-colors duration-200 shadow-sm">
            Thêm tuyến mới
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center p-4 text-sm text-emerald-800 dark:text-emerald-400 rounded-lg bg-emerald-50 dark:bg-gray-800 border border-emerald-200 dark:border-emerald-800">
            <span class="font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center p-4 text-sm text-red-800 dark:text-red-400 rounded-lg bg-red-50 dark:bg-gray-800 border border-red-200 dark:border-red-800">
            <span class="font-medium">@TempData["ErrorMessage"]</span>
        </div>
    }

    <form method="get" asp-action="Index" class="flex flex-col md:flex-row md:items-center gap-3">
        <input type="text"
               name="searchTerm"
               value="@searchTerm"
               placeholder="Tìm theo điểm đi hoặc điểm đến..."
               class="w-full md:w-72 px-4 py-2.5 text-sm bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-amber-400 focus:border-amber-400 placeholder-gray-500" />

        <select name="departurePoint"
                class="w-full md:w-56 px-4 py-2.5 text-sm bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-amber-400 focus:border-amber-400">
            <option value="" selected="@(departureFilter == string.Empty)">Tất cả điểm đi</option>
            @foreach (var point in departureOptions)
            {
                <option value="@point" selected="@(departureFilter == point)">@point</option>
            }
        </select>

        <select name="destinationPoint"
                class="w-full md:w-56 px-4 py-2.5 text-sm bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-amber-400 focus:border-amber-400">
            <option value="" selected="@(destinationFilter == string.Empty)">Tất cả điểm đến</option>
            @foreach (var point in destinationOptions)
            {
                <option value="@point" selected="@(destinationFilter == point)">@point</option>
            }
        </select>

        <button type="submit"
                class="px-5 py-2.5 text-sm font-semibold text-gray-900 bg-amber-400 hover:bg-amber-500 rounded-lg">
            Lọc
        </button>

        @if (hasActiveFilter)
        {
            <a asp-action="Index"
               class="px-5 py-2.5 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">
                Xóa lọc
            </a>
        }
    </form>

    <div class="w-full max-w-full overflow-hidden bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-xl">
        <div class="w-full overflow-x-auto">
            <table class="w-full min-w-[760px] table-auto text-sm text-left text-gray-600 dark:text-gray-300">
                <thead class="text-xs uppercase bg-gray-50 dark:bg-gray-900 text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                <tr>
                    <th class="px-5 py-4">Điểm đi</th>
                    <th class="px-5 py-4">Điểm đến</th>
                    <th class="px-5 py-4">Khoảng cách</th>
                    <th class="px-5 py-4 text-right">Hành động</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-gray-500">
                            @(hasActiveFilter ? "Không có tuyến đường phù hợp." : "Chưa có tuyến đường.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors duration-150">
                            <td class="px-5 py-4 font-semibold text-gray-900 dark:text-white">
                                @item.DeparturePoint
                            </td>
                            <td class="px-5 py-4 text-gray-900 dark:text-white">
                                @item.DestinationPoint
                            </td>
                            <td class="px-5 py-4">
                                @item.DistanceKm km
                            </td>
                            <td class="px-5 py-4 text-right">
                                <button type="button"
                                        onclick="editRoute('@item.Id')"
                                        class="text-amber-500 dark:text-amber-400 hover:text-amber-600 dark:hover:text-amber-300 font-semibold">
                                    Sửa
                                </button>
                                <span class="mx-2 text-gray-300 dark:text-gray-600">|</span>
                                <button type="button"
                                        onclick="deleteRoute('@item.Id')"
                                        class="text-rose-500 dark:text-rose-400 hover:text-rose-600 dark:hover:text-rose-300 font-semibold">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between p-4 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 gap-4">
            <span class="text-sm text-gray-400">
                Hiển thị từ <span class="font-semibold text-gray-900 dark:text-white">@startItem</span> đến
                <span class="font-semibold text-gray-900 dark:text-white">@endItem</span> trong tổng số
                <span class="font-semibold text-gray-900 dark:text-white">@totalItems</span> tuyến đường
            </span>

            @if (totalPages > 1)
            {
                <nav class="inline-flex items-center -space-x-px rounded-md shadow-sm">
                    <a asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-searchTerm="@searchTerm"
                       asp-route-departurePoint="@departureFilter"
                       asp-route-destinationPoint="@destinationFilter"
                       class="relative inline-flex items-center rounded-l-md px-3 py-2 text-sm font-medium border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white @(currentPage == 1 ? "pointer-events-none opacity-40" : "")">
                        Trước
                    </a>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="relative z-10 inline-flex items-center bg-amber-400 px-4 py-2 text-sm font-semibold text-gray-900 border border-amber-400">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@searchTerm"
                               asp-route-departurePoint="@departureFilter"
                               asp-route-destinationPoint="@destinationFilter"
                               class="relative inline-flex items-center border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white">
                                @i
                            </a>
                        }
                    }

                    <a asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-searchTerm="@searchTerm"
                       asp-route-departurePoint="@departureFilter"
                       asp-route-destinationPoint="@destinationFilter"
                       class="relative inline-flex items-center rounded-r-md px-3 py-2 text-sm font-medium border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white @(currentPage == totalPages ? "pointer-events-none opacity-40" : "")">
                        Tiếp
                    </a>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Modal Delete -->
<div id="modal-route-delete"
     tabindex="-1"
     aria-hidden="true"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70">
    <div class="relative w-full max-w-md mx-4 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700">
        <div class="p-6">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
                Xác nhận xóa
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
                Bạn có chắc chắn muốn xóa tuyến đường này không?
            </p>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="DeleteId" name="id" />
                <div class="flex justify-end gap-3">
                    <button type="button"
                            onclick="hideRouteModal('modal-route-delete')"
                            class="px-6 py-2.5 text-sm font-semibold text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                        Hủy
                    </button>
                    <button type="submit"
                            class="px-6 py-2.5 rounded-lg bg-red-600 text-white font-semibold hover:bg-red-700">
                        Xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Create -->
<div id="modal-route-create"
     tabindex="-1"
     aria-hidden="true"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70">
    <div class="relative w-full max-w-2xl mx-4 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                Thêm tuyến đường
            </h3>
            <button type="button"
                    onclick="hideRouteModal('modal-route-create')"
                    class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white text-sm font-semibold">
                Đóng
            </button>
        </div>
        <form asp-action="Create" method="post" class="p-6 space-y-6">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_BusRouteFormFields", new Bus_ticket.ViewModels.BusRouteFormViewModel())
            <div class="flex justify-end gap-3">
                <button type="button"
                        onclick="hideRouteModal('modal-route-create')"
                        class="px-6 py-2.5 text-sm font-semibold text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    Hủy
                </button>
                <button type="submit"
                        class="px-6 py-2.5 rounded-lg bg-amber-400 text-gray-900 font-semibold hover:bg-amber-500">
                    Lưu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Edit -->
<div id="modal-route-edit"
     tabindex="-1"
     aria-hidden="true"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70">
    <div class="relative w-full max-w-2xl mx-4 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                Cập nhật tuyến đường
            </h3>
            <button type="button"
                    onclick="hideRouteModal('modal-route-edit')"
                    class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white text-sm font-semibold">
                Đóng
            </button>
        </div>
        <form asp-action="Edit" method="post" class="p-6 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" id="EditId" name="Id" />
            @await Html.PartialAsync(
                "_BusRouteFormFields",
                new Bus_ticket.ViewModels.BusRouteFormViewModel(),
                new ViewDataDictionary(ViewData)
                {
                    ["IdPrefix"] = "Edit"
                })
            <div class="flex justify-end gap-3">
                <button type="button"
                        onclick="hideRouteModal('modal-route-edit')"
                        class="px-6 py-2.5 text-sm font-semibold text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    Hủy
                </button>
                <button type="submit"
                        class="px-6 py-2.5 rounded-lg bg-amber-400 text-gray-900 font-semibold hover:bg-amber-500">
                    Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function showRouteModal(id) {
        document.getElementById(id).classList.remove("hidden");
    }

    function hideRouteModal(id) {
        document.getElementById(id).classList.add("hidden");
    }

    async function editRoute(id) {
        const response = await fetch("/BusRoutes/GetForEdit?id=" + id);
        const data = await response.json();

        document.getElementById("EditId").value = data.id;
        document.getElementById("EditDeparturePoint").value = data.departurePoint;
        document.getElementById("EditDestinationPoint").value = data.destinationPoint;
        document.getElementById("EditDistanceKm").value = data.distanceKm;

        showRouteModal("modal-route-edit");
    }

    function deleteRoute(id) {
        document.getElementById("DeleteId").value = id;
        showRouteModal("modal-route-delete");
    }
</script>
