@model Bus_ticket.ViewModels.ResetPasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt lại mật khẩu";
    var invalidLink = ViewBag.InvalidLink is true;
}

<style>
    .validation-summary-valid { display: none; }
</style>

<main class="min-h-[calc(100vh-150px)] bg-slate-50 py-10 sm:py-14">
    <section class="container mx-auto px-4">
        <div class="mx-auto max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl shadow-slate-200/70">
            <div class="h-2 bg-gradient-to-r from-emerald-500 via-green-600 to-lime-500"></div>
            <div class="p-6 sm:p-10 lg:p-12">
                <div class="text-center">
                    <div class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-green-50 text-green-600 ring-1 ring-green-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 0h10.5A2.25 2.25 0 0119.5 12.75v6A2.25 2.25 0 0117.25 21H6.75a2.25 2.25 0 01-2.25-2.25v-6a2.25 2.25 0 012.25-2.25z" />
                        </svg>
                    </div>
                    <p class="mt-6 text-sm font-bold uppercase tracking-[0.18em] text-green-600">Secure password</p>
                    <h2 class="mt-2 text-3xl font-black text-slate-900 sm:text-4xl">Đặt lại mật khẩu</h2>
                    <p class="mx-auto mt-3 max-w-lg leading-7 text-slate-500">
                        Tạo mật khẩu mới cho tài khoản SRC Travel Agencies của bạn.
                    </p>
                </div>

                @if (ViewBag.Message != null)
                {
                    <div class="mt-7 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-700">
                        @ViewBag.Message
                    </div>
                }

                @if (!invalidLink)
                {
                    <form asp-action="ResetPassword" asp-controller="Account" method="post" class="mt-8 space-y-5">
                        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>

                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div>
                            <label asp-for="NewPassword" class="mb-2 block text-sm font-bold text-slate-700"></label>
                            <input asp-for="NewPassword"
                                   autocomplete="new-password"
                                   placeholder="Nhập mật khẩu mới"
                                   class="h-12 w-full rounded-xl border border-slate-300 px-4 text-slate-900 outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-100" />
                            <span asp-validation-for="NewPassword" class="mt-2 block text-sm text-red-600"></span>
                        </div>

                        <div>
                            <label asp-for="ConfirmNewPassword" class="mb-2 block text-sm font-bold text-slate-700"></label>
                            <input asp-for="ConfirmNewPassword"
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu mới"
                                   class="h-12 w-full rounded-xl border border-slate-300 px-4 text-slate-900 outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-100" />
                            <span asp-validation-for="ConfirmNewPassword" class="mt-2 block text-sm text-red-600"></span>
                        </div>

                        <div class="rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-600 ring-1 ring-slate-200">
                            Mật khẩu phải có ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                        </div>

                        <button type="submit"
                                class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-green-600 px-5 font-bold text-white shadow-lg shadow-green-600/20 transition hover:-translate-y-0.5 hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-green-200">
                            Lưu mật khẩu mới
                            <span aria-hidden="true">→</span>
                        </button>
                    </form>
                }

                <div class="mt-8 border-t border-slate-200 pt-6 text-center">
                    @if (invalidLink)
                    {
                        <a asp-action="ForgotPassword" asp-controller="Account"
                           class="inline-flex items-center gap-2 text-sm font-bold text-green-700 hover:text-green-800 hover:underline">
                            Tạo liên kết mới
                            <span aria-hidden="true">→</span>
                        </a>
                    }
                    else
                    {
                        <a asp-action="Login" asp-controller="Account"
                           class="inline-flex items-center gap-2 text-sm font-bold text-green-700 hover:text-green-800 hover:underline">
                            <span aria-hidden="true">←</span>
                            Quay lại đăng nhập
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
