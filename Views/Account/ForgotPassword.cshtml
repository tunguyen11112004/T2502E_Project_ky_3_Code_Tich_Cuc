@model Bus_ticket.ViewModels.ForgotPasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    .validation-summary-valid { display: none; }
</style>

<main class="min-h-[calc(100vh-150px)] bg-slate-50 py-10 sm:py-14">
    <section class="container mx-auto px-4">
        <div class="mx-auto grid max-w-5xl overflow-hidden rounded-3xl bg-white shadow-2xl shadow-slate-200/70 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="relative hidden min-h-[560px] overflow-hidden bg-gradient-to-br from-emerald-600 via-green-600 to-lime-500 p-10 text-white lg:flex lg:flex-col lg:justify-between">
                <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10"></div>
                <div class="absolute -bottom-28 -left-20 h-80 w-80 rounded-full bg-black/10"></div>

                <div class="relative z-10">
                    <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/30 backdrop-blur">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                        </svg>
                    </div>
                    <h1 class="mt-7 text-4xl font-black leading-tight">SRC Travel Agencies</h1>
                    <p class="mt-4 max-w-sm text-base leading-7 text-white/85">
                        Khôi phục quyền truy cập tài khoản nhân viên bằng liên kết bảo mật có hiệu lực trong 15 phút.
                    </p>
                </div>

                <div class="relative z-10 rounded-2xl border border-white/20 bg-white/10 p-5 backdrop-blur">
                    <p class="text-sm font-semibold">Bảo mật tài khoản</p>
                    <p class="mt-2 text-sm leading-6 text-white/80">
                        Hệ thống không tiết lộ email nào đang tồn tại và mỗi liên kết chỉ được sử dụng một lần.
                    </p>
                </div>
            </div>

            <div class="flex items-center p-6 sm:p-10 lg:p-14">
                <div class="w-full">
                    <div class="mb-8">
                        <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-green-50 text-green-600 ring-1 ring-green-100 lg:hidden">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                            </svg>
                        </div>
                        <p class="text-sm font-bold uppercase tracking-[0.18em] text-green-600">Account recovery</p>
                        <h2 class="mt-2 text-3xl font-black text-slate-900 sm:text-4xl">Quên mật khẩu?</h2>
                        <p class="mt-3 leading-7 text-slate-500">
                            Nhập email tài khoản. Hệ thống sẽ tạo liên kết đặt lại mật khẩu bảo mật.
                        </p>
                    </div>

                    @if (ViewBag.Message != null)
                    {
                        <div class="mb-5 rounded-2xl border border-green-200 bg-green-50 p-4 text-sm leading-6 text-green-800">
                            <div class="flex gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2.25 2.25L15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span>@ViewBag.Message</span>
                            </div>
                        </div>
                    }

                    @if (ViewBag.ResetLink != null)
                    {
                        <div class="mb-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                            <p class="font-bold">Liên kết dùng để test trên localhost</p>
                            <p class="mt-1 leading-6">Liên kết hết hạn sau 15 phút và chỉ dùng được một lần.</p>
                            <a href="@ViewBag.ResetLink"
                               class="mt-3 inline-flex items-center gap-2 break-all font-bold text-green-700 hover:text-green-800 hover:underline">
                                Mở trang đặt lại mật khẩu
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    }

                    <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="space-y-5">
                        <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>

                        <div>
                            <label asp-for="Email" class="mb-2 block text-sm font-bold text-slate-700"></label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                                    </svg>
                                </span>
                                <input asp-for="Email"
                                       autocomplete="email"
                                       placeholder="ticketagent.hn@src.com"
                                       class="h-12 w-full rounded-xl border border-slate-300 bg-white pl-12 pr-4 text-slate-900 outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-100" />
                            </div>
                            <span asp-validation-for="Email" class="mt-2 block text-sm text-red-600"></span>
                        </div>

                        <button type="submit"
                                class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-green-600 px-5 font-bold text-white shadow-lg shadow-green-600/20 transition hover:-translate-y-0.5 hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-green-200">
                            Tạo liên kết đặt lại mật khẩu
                            <span aria-hidden="true">→</span>
                        </button>
                    </form>

                    <div class="mt-7 border-t border-slate-200 pt-6 text-center">
                        <a asp-action="Login" asp-controller="Account"
                           class="inline-flex items-center gap-2 text-sm font-bold text-green-700 hover:text-green-800 hover:underline">
                            <span aria-hidden="true">←</span>
                            Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
