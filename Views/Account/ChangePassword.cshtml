@model Bus_ticket.ViewModels.ChangePasswordViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    .validation-summary-valid { display: none; }
</style>

<div class="mx-auto max-w-5xl">
    <div class="mb-6">
        <p class="text-sm font-semibold text-green-600 dark:text-green-400">Tài khoản & bảo mật</p>
        <h1 class="mt-1 text-2xl font-black text-gray-900 dark:text-white sm:text-3xl">Đổi mật khẩu</h1>
        <p class="mt-2 text-sm leading-6 text-gray-500 dark:text-gray-400">
            Cập nhật mật khẩu đăng nhập của bạn. Sau khi đổi thành công, hệ thống sẽ yêu cầu đăng nhập lại.
        </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <aside class="overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-600 via-green-600 to-lime-500 p-6 text-white shadow-xl shadow-green-600/15 sm:p-8">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15 ring-1 ring-white/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 00-9 0v3.75m-.75 0h10.5A2.25 2.25 0 0119.5 12.75v6A2.25 2.25 0 0117.25 21H6.75a2.25 2.25 0 01-2.25-2.25v-6a2.25 2.25 0 012.25-2.25z" />
                </svg>
            </div>

            <h2 class="mt-6 text-2xl font-black">Bảo vệ tài khoản của bạn</h2>
            <p class="mt-3 text-sm leading-7 text-white/85">
                Không sử dụng lại mật khẩu cũ và không chia sẻ mật khẩu với người khác.
            </p>

            <ul class="mt-7 space-y-4 text-sm text-white/90">
                <li class="flex gap-3">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white/20">✓</span>
                    Ít nhất 8 ký tự.
                </li>
                <li class="flex gap-3">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white/20">✓</span>
                    Có chữ hoa, chữ thường và số.
                </li>
                <li class="flex gap-3">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white/20">✓</span>
                    Có ít nhất một ký tự đặc biệt.
                </li>
            </ul>
        </aside>

        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800 sm:p-8">
            <form asp-action="ChangePassword" asp-controller="Account" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly"
                     class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-300"></div>

                <div>
                    <label asp-for="CurrentPassword" class="mb-2 block text-sm font-bold text-gray-700 dark:text-gray-200"></label>
                    <input asp-for="CurrentPassword"
                           autocomplete="current-password"
                           placeholder="Nhập mật khẩu hiện tại"
                           class="block h-12 w-full rounded-xl border border-gray-300 bg-white px-4 text-gray-900 outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-100 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:ring-green-900/40" />
                    <span asp-validation-for="CurrentPassword" class="mt-2 block text-sm text-red-600 dark:text-red-400"></span>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="NewPassword" class="mb-2 block text-sm font-bold text-gray-700 dark:text-gray-200"></label>
                        <input asp-for="NewPassword"
                               autocomplete="new-password"
                               placeholder="Nhập mật khẩu mới"
                               class="block h-12 w-full rounded-xl border border-gray-300 bg-white px-4 text-gray-900 outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-100 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:ring-green-900/40" />
                        <span asp-validation-for="NewPassword" class="mt-2 block text-sm text-red-600 dark:text-red-400"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmNewPassword" class="mb-2 block text-sm font-bold text-gray-700 dark:text-gray-200"></label>
                        <input asp-for="ConfirmNewPassword"
                               autocomplete="new-password"
                               placeholder="Nhập lại mật khẩu mới"
                               class="block h-12 w-full rounded-xl border border-gray-300 bg-white px-4 text-gray-900 outline-none transition focus:border-green-500 focus:ring-4 focus:ring-green-100 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:ring-green-900/40" />
                        <span asp-validation-for="ConfirmNewPassword" class="mt-2 block text-sm text-red-600 dark:text-red-400"></span>
                    </div>
                </div>

                <div class="rounded-xl bg-gray-50 p-4 text-sm leading-6 text-gray-600 ring-1 ring-gray-200 dark:bg-gray-900/50 dark:text-gray-300 dark:ring-gray-700">
                    Sau khi lưu, phiên đăng nhập hiện tại sẽ kết thúc để bảo vệ tài khoản.
                </div>

                <div class="flex flex-col-reverse gap-3 border-t border-gray-200 pt-6 dark:border-gray-700 sm:flex-row sm:justify-end">
                    <a href="javascript:history.back()"
                       class="inline-flex h-11 items-center justify-center rounded-xl border border-gray-300 px-5 text-sm font-bold text-gray-700 transition hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700">
                        Hủy
                    </a>
                    <button type="submit"
                            class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-green-600 px-6 text-sm font-bold text-white shadow-lg shadow-green-600/20 transition hover:-translate-y-0.5 hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-green-200 dark:focus:ring-green-900/50">
                        Lưu mật khẩu mới
                        <span aria-hidden="true">→</span>
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
